@model RealEstatePortfolio.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Staff & Executive Authentication";
}

<section class="py-5 my-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5 col-xl-4">
                <div class="glass-card p-4 p-sm-5 shadow-lg" data-aos="zoom-in">
                    <div class="text-center mb-4">
                        <span class="d-inline-flex p-3 rounded-circle bg-primary bg-opacity-10 text-primary mb-3">
                            <i class="bi bi-shield-lock-fill fs-2"></i>
                        </span>
                        <h4 class="fw-bold mb-1">Staff Portal Login</h4>
                        <p class="text-muted small">Enter your authorized management credentials</p>
                    </div>

                    <form asp-action="Login" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ReturnUrl" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger small p-2 mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label small fw-semibold">Email Address</label>
                            <div class="input-group">
                                <span class="input-group-text bg-body text-muted"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" class="form-control rounded-end-3" placeholder="admin@realestate.com" required />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label small fw-semibold">Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-body text-muted"><i class="bi bi-key"></i></span>
                                <input asp-for="Password" type="password" class="form-control rounded-end-3" placeholder="••••••••" required />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input asp-for="RememberMe" class="form-check-input" />
                                <label asp-for="RememberMe" class="form-check-label small"></label>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary rounded-pill w-100 py-3 fw-bold shadow-sm">
                            <i class="bi bi-box-arrow-in-right me-2"></i> Sign In to Dashboard
                        </button>
                    </form>

                    <div class="mt-4 pt-3 border-top text-center text-muted small">
                        <p class="mb-1 fw-semibold text-body">Demo Seed Credentials:</p>
                        <div>Admin: <code>admin@realestate.com</code> / <code>Admin@123456!</code></div>
                        <div>Editor: <code>editor@realestate.com</code> / <code>Editor@123456!</code></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
