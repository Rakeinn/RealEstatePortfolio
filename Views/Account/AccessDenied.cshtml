@{
    ViewData["Title"] = "Access Restricted";
}

<section class="py-5 my-5 text-center">
    <div class="container">
        <div class="glass-card p-5 max-w-500 mx-auto shadow-lg">
            <span class="d-inline-flex p-3 rounded-circle bg-danger bg-opacity-10 text-danger mb-3">
                <i class="bi bi-shield-x fs-1"></i>
            </span>
            <h3 class="fw-bold mb-2">Access Restricted</h3>
            <p class="text-muted mb-4">You do not have the required role clearance to view this management module.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4">
                Return to Homepage
            </a>
        </div>
    </div>
</section>
