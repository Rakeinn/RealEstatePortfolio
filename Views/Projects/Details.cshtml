@model RealEstatePortfolio.Models.ViewModels.ProjectDetailViewModel

@{
    var b = Model.Building;
    var sisterConcern = b.SisterConcern ?? "Recent Properties Ltd";
}

<!-- Breadcrumbs -->
<section class="py-3 border-bottom bg-body-tertiary">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Projects" asp-action="Index" class="text-decoration-none text-muted">Projects</a></li>
                <li class="breadcrumb-item"><a asp-controller="Projects" asp-action="Index" asp-route-sisterConcern="@sisterConcern" class="text-decoration-none text-muted">@sisterConcern</a></li>
                <li class="breadcrumb-item active text-primary fw-semibold" aria-current="page">@b.Name</li>
            </ol>
        </nav>
    </div>
</section>

<!-- Property Header & Image Gallery -->
<section class="py-5">
    <div class="container">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <span class="badge bg-primary px-3 py-2"><i class="bi bi-building me-1"></i>@sisterConcern</span>
                    <span class="badge badge-status-@(b.Status.ToString().ToLower()) px-3 py-2">@b.Status</span>
                    <span class="badge bg-secondary bg-opacity-10 text-body border px-3 py-2">@(b.PropertyType ?? "Residential")</span>
                    @if (b.CompletionYear.HasValue)
                    {
                        <span class="badge bg-dark bg-opacity-75 text-white px-3 py-2">Est. @b.CompletionYear</span>
                    }
                </div>
                <h1 class="display-4 fw-bold mb-1 font-serif">@b.Name</h1>
                <p class="text-muted lead fs-6 mb-0"><i class="bi bi-geo-alt-fill text-primary me-2"></i>@b.Address</p>
            </div>

            <div>
                <a href="#inquiry-section" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm">
                    <i class="bi bi-chat-dots-fill"></i>
                    <span>Inquire Now</span>
                </a>
            </div>
        </div>

        <!-- Swiper.js Gallery & Synchronized Thumbs -->
        <div class="glass-card p-2 p-sm-3 shadow-lg mb-5">
            <div class="swiper swiper-details-main project-details-swiper">
                <div class="swiper-wrapper">
                    @foreach (var img in b.Images.OrderBy(i => i.DisplayOrder))
                    {
                        <div class="swiper-slide position-relative gallery-slide-container">
                            <img src="@img.ImagePath" alt="@(img.Caption ?? b.Name)" class="gallery-slide-img" />
                            @if (!string.IsNullOrWhiteSpace(img.Caption))
                            {
                                <div class="position-absolute bottom-0 start-0 end-0 p-3 bg-dark bg-opacity-75 text-white small backdrop-blur">
                                    <i class="bi bi-camera me-1 text-primary"></i>@img.Caption
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="swiper-button-next text-white"></div>
                <div class="swiper-button-prev text-white"></div>
                <div class="swiper-pagination"></div>
            </div>

            <div class="swiper swiper-details-thumbs swiper-thumbs-gallery">
                <div class="swiper-wrapper">
                    @foreach (var img in b.Images.OrderBy(i => i.DisplayOrder))
                    {
                        <div class="swiper-slide">
                            <img src="@img.ImagePath" alt="Thumbnail" class="w-100 h-100 object-fit-cover" />
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="row g-5">
            <!-- Left Column: Specs, Highlights, Apartment Contains, Description, Features, Neighborhood -->
            <div class="col-lg-8">
                <!-- Specs Bar -->
                <div class="glass-card p-4 mb-4">
                    <h5 class="fw-bold mb-3 border-bottom pb-2 font-serif">Architectural Specifications</h5>
                    <div class="row g-3 text-center text-sm-start">
                        <div class="col-6 col-sm-3">
                            <span class="text-muted small d-block">Sister Concern</span>
                            <strong class="text-primary">@sisterConcern</strong>
                        </div>
                        <div class="col-6 col-sm-3">
                            <span class="text-muted small d-block">Status</span>
                            <strong class="text-body">@(!string.IsNullOrWhiteSpace(b.HandoverDate) ? b.HandoverDate : b.Status.ToString())</strong>
                        </div>
                        <div class="col-6 col-sm-3">
                            <span class="text-muted small d-block">Category</span>
                            <strong class="text-body">@(b.PropertyType ?? "Residential")</strong>
                        </div>
                        <div class="col-6 col-sm-3">
                            <span class="text-muted small d-block">@(b.TotalUnits.HasValue ? "Total Units" : "Completion")</span>
                            <strong class="text-body">@(b.TotalUnits.HasValue ? $"{b.TotalUnits} Units" : (b.CompletionYear.HasValue ? b.CompletionYear.ToString() : "Ongoing"))</strong>
                        </div>
                    </div>
                </div>

                <!-- Property Highlights (when provided) -->
                @if (!string.IsNullOrWhiteSpace(b.Facing) || !string.IsNullOrWhiteSpace(b.Storied) || !string.IsNullOrWhiteSpace(b.ApartmentSize) || !string.IsNullOrWhiteSpace(b.LandSize))
                {
                    <div class="glass-card p-4 p-lg-5 mb-4">
                        <h4 class="fw-bold mb-3 font-serif"><i class="bi bi-stars text-primary me-2"></i>Property Highlights</h4>
                        <div class="row g-3">
                            @if (!string.IsNullOrWhiteSpace(b.Facing))
                            {
                                <div class="col-sm-6">
                                    <div class="p-3 rounded-3 bg-body border h-100">
                                        <small class="text-muted d-block mb-1">Facing</small>
                                        <strong class="text-body"><i class="bi bi-compass me-1 text-primary"></i>@b.Facing</strong>
                                    </div>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(b.Storied))
                            {
                                <div class="col-sm-6">
                                    <div class="p-3 rounded-3 bg-body border h-100">
                                        <small class="text-muted d-block mb-1">Storied</small>
                                        <strong class="text-body"><i class="bi bi-layers me-1 text-primary"></i>@b.Storied</strong>
                                    </div>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(b.ApartmentSize))
                            {
                                <div class="col-sm-6">
                                    <div class="p-3 rounded-3 bg-body border h-100">
                                        <small class="text-muted d-block mb-1">Apartment Size</small>
                                        <strong class="text-body"><i class="bi bi-aspect-ratio me-1 text-primary"></i>@b.ApartmentSize</strong>
                                    </div>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(b.LandSize))
                            {
                                <div class="col-sm-6">
                                    <div class="p-3 rounded-3 bg-body border h-100">
                                        <small class="text-muted d-block mb-1">Land Size</small>
                                        <strong class="text-body"><i class="bi bi-rulers me-1 text-primary"></i>@b.LandSize</strong>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Apartment Contains -->
                @if (b.ApartmentContainsList.Any())
                {
                    <div class="glass-card p-4 p-lg-5 mb-4">
                        <h4 class="fw-bold mb-3 font-serif"><i class="bi bi-door-open text-primary me-2"></i>Apartment Contains</h4>
                        <div class="row g-3">
                            @foreach (var item in b.ApartmentContainsList)
                            {
                                <div class="col-md-6">
                                    <div class="d-flex align-items-center gap-3 p-3 rounded-3 bg-body border">
                                        <i class="bi bi-check2-circle text-success fs-5"></i>
                                        <span class="fw-medium">@item</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Rich Text Description -->
                <div class="glass-card p-4 p-lg-5 mb-4">
                    <h4 class="fw-bold mb-4 font-serif">Overview &amp; Design Narrative</h4>
                    <div class="text-muted lh-lg">
                        @Html.Raw(b.LongDescription)
                    </div>
                </div>

                <!-- Common Features & Amenities -->
                @if (b.FeatureList.Any())
                {
                    <div class="glass-card p-4 p-lg-5 mb-4">
                        <h4 class="fw-bold mb-3 font-serif"><i class="bi bi-layers-half text-primary me-2"></i>Common Features &amp; Amenities</h4>
                        <p class="text-muted small mb-4">Shared building facilities and engineering amenities for residents.</p>
                        
                        <div class="row g-3">
                            @foreach (var feat in b.FeatureList)
                            {
                                <div class="col-md-6">
                                    <div class="d-flex align-items-center gap-3 p-3 rounded-3 bg-body border">
                                        <i class="bi bi-shield-check text-primary fs-4"></i>
                                        <span class="fw-medium">@feat</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Neighborhood Connectivity (when provided) -->
                @if (b.NeighborhoodSchoolsList.Any() || b.NeighborhoodHospitalsList.Any() || b.NeighborhoodTransitList.Any())
                {
                    <div class="glass-card p-4 p-lg-5 mb-4">
                        <h4 class="fw-bold mb-4 font-serif"><i class="bi bi-signpost-split text-primary me-2"></i>Neighborhood</h4>
                        <div class="row g-4">
                            @if (b.NeighborhoodSchoolsList.Any())
                            {
                                <div class="col-12">
                                    <h6 class="fw-bold text-primary mb-2"><i class="bi bi-mortarboard-fill me-2"></i>School, Colleges &amp; University</h6>
                                    <ul class="list-group list-group-flush rounded-3 border overflow-hidden">
                                        @foreach (var s in b.NeighborhoodSchoolsList)
                                        {
                                            <li class="list-group-item bg-body text-body small py-2 px-3">@s</li>
                                        }
                                    </ul>
                                </div>
                            }
                            @if (b.NeighborhoodHospitalsList.Any())
                            {
                                <div class="col-12">
                                    <h6 class="fw-bold text-danger mb-2"><i class="bi bi-hospital-fill me-2"></i>Hospitals</h6>
                                    <ul class="list-group list-group-flush rounded-3 border overflow-hidden">
                                        @foreach (var h in b.NeighborhoodHospitalsList)
                                        {
                                            <li class="list-group-item bg-body text-body small py-2 px-3">@h</li>
                                        }
                                    </ul>
                                </div>
                            }
                            @if (b.NeighborhoodTransitList.Any())
                            {
                                <div class="col-12">
                                    <h6 class="fw-bold text-success mb-2"><i class="bi bi-train-front-fill me-2"></i>Bus / Train Station &amp; Airport</h6>
                                    <ul class="list-group list-group-flush rounded-3 border overflow-hidden">
                                        @foreach (var t in b.NeighborhoodTransitList)
                                        {
                                            <li class="list-group-item bg-body text-body small py-2 px-3">@t</li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Location & Neighborhood Information -->
                <div class="glass-card p-4 p-lg-5 mb-4">
                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
                        <div>
                            <h4 class="fw-bold mb-1 font-serif"><i class="bi bi-geo-alt-fill text-primary me-2"></i>Prime Location</h4>
                            <p class="text-muted small mb-0">@(b.Address ?? "Dhaka, Bangladesh")</p>
                        </div>
                        <a href="https://www.google.com/maps/search/?api=1&query=@Uri.EscapeDataString(b.Address ?? (b.Name + " Dhaka Bangladesh"))" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary rounded-pill px-4 py-2 small fw-semibold d-inline-flex align-items-center gap-2">
                            <i class="bi bi-map-fill"></i>
                            <span>Open in Google Maps</span>
                        </a>
                    </div>
                    <div class="p-4 rounded-3 bg-body border">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <small class="text-muted d-block mb-1">Region</small>
                                <strong class="text-body"><i class="bi bi-compass me-1 text-primary"></i>Dhaka Metro</strong>
                            </div>
                            <div class="col-md-4">
                                <small class="text-muted d-block mb-1">Development Wing</small>
                                <strong class="text-primary"><i class="bi bi-building me-1"></i>@sisterConcern</strong>
                            </div>
                            <div class="col-md-4">
                                <small class="text-muted d-block mb-1">Status</small>
                                <strong class="text-success"><i class="bi bi-check2-circle me-1"></i>@b.Status</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Direct Inquiry Form -->
            <div class="col-lg-4">
                <div class="sticky-top" style="top: 100px; z-index: 10;" id="inquiry-section">
                    <!-- Direct Inquiry Form -->
                    <div class="glass-card p-4">
                        <h5 class="fw-bold mb-1 font-serif">Inquire About This Property</h5>
                        <p class="text-muted small mb-3">Direct inquiry to <strong>@sisterConcern</strong>.</p>

                        <form class="ajax-inquiry-form">
                            <input type="hidden" name="PreferredProjectSlug" value="@b.Slug" />
                            <input type="hidden" name="TargetedConcern" value="@sisterConcern" />
                            <input type="hidden" name="Subject" value="Inquiry Regarding @b.Name" />

                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Your Name *</label>
                                <input type="text" name="ClientName" class="form-control rounded-3 py-2" placeholder="Full name" required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Email Address *</label>
                                <input type="email" name="EmailAddress" class="form-control rounded-3 py-2" placeholder="email@address.com" required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Phone Number</label>
                                <input type="tel" name="PhoneNumber" class="form-control rounded-3 py-2" placeholder="+880 1711 000000" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Message</label>
                                <textarea name="Message" class="form-control rounded-3" rows="3" placeholder="Specify questions or viewing dates..." required></textarea>
                            </div>

                            <button type="submit" class="btn btn-outline-primary w-100 rounded-pill py-3 fw-bold">
                                <i class="bi bi-send-fill me-2"></i>Send Inquiry to @sisterConcern
                            </button>
                            <div class="inquiry-alert-box d-none"></div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Similar Projects Section -->
        @if (Model.SimilarProjects.Any())
        {
            <div class="mt-5 pt-5 border-top" data-aos="fade-up">
                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-end gap-3 mb-4">
                    <div>
                        <span class="badge-editorial mb-2">Similar Portfolio</span>
                        <h3 class="fw-bold mb-0 font-serif">Complementary Recent Group Works</h3>
                    </div>
                    <a asp-action="Index" class="btn btn-outline-primary rounded-pill px-4 align-self-start align-self-sm-auto">Browse All Projects &rarr;</a>
                </div>

                <div class="row g-4">
                    @foreach (var sim in Model.SimilarProjects)
                    {
                        <div class="col-md-4">
                            <div class="card h-100 glass-card glass-card-hover overflow-hidden d-flex flex-column project-card-modern">
                                <div class="project-card-image-wrap position-relative overflow-hidden">
                                    <img src="@(sim.PrimaryImage?.ImagePath ?? "/images/properties/lumina-1.svg")" alt="@sim.Name" class="w-100 h-100 project-card-img" loading="lazy" />
                                    <div class="position-absolute top-0 start-0 m-3">
                                        <span class="badge badge-status-@(sim.Status.ToString().ToLower()) shadow-sm">@sim.Status</span>
                                    </div>
                                    <div class="position-absolute top-0 end-0 m-3">
                                        <span class="badge bg-primary bg-opacity-90 text-white shadow-sm fw-semibold">@(sim.PropertyType ?? "Residential")</span>
                                    </div>
                                </div>
                                <div class="card-body p-4 d-flex flex-column">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="badge bg-secondary bg-opacity-10 text-body border small">@(sim.SisterConcern ?? "Recent Properties Ltd")</span>
                                    </div>
                                    <h5 class="card-title fw-bold font-serif mb-2 fs-6">
                                        <a asp-action="Details" asp-route-slug="@sim.Slug" class="text-decoration-none text-body stretched-link">
                                            @sim.Name
                                        </a>
                                    </h5>
                                    <p class="text-muted small mb-3"><i class="bi bi-geo-alt me-1 text-primary"></i>@sim.Address</p>
                                    <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                                        <span class="text-primary fw-semibold small d-inline-flex align-items-center gap-1">
                                            View Details
                                        </span>
                                        <span class="btn btn-outline-primary btn-sm rounded-circle p-2"><i class="bi bi-arrow-right"></i></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const thumbsSwiper = new Swiper('.swiper-details-thumbs', {
                spaceBetween: 10,
                slidesPerView: 4,
                freeMode: true,
                watchSlidesProgress: true,
                breakpoints: {
                    640: { slidesPerView: 5 },
                    1024: { slidesPerView: 6 }
                }
            });

            const mainSwiper = new Swiper('.swiper-details-main', {
                spaceBetween: 10,
                navigation: {
                    nextEl: '.swiper-button-next',
                    prevEl: '.swiper-button-prev',
                },
                pagination: {
                    el: '.swiper-pagination',
                    clickable: true,
                },
                thumbs: {
                    swiper: thumbsSwiper,
                },
            });


        });
    </script>
}
