@model RealEstatePortfolio.Models.ViewModels.ProjectDetailViewModel

@{
    var b = Model.Building;
    var priceFormatted = b.PriceStartingFrom.HasValue ? $"${b.PriceStartingFrom:N0}" : "Price on Request";
    var sisterConcern = b.SisterConcern ?? "Recent Properties Ltd";
}

<!-- Breadcrumbs -->
<section class="py-3 border-bottom bg-body-tertiary">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Projects" asp-action="Index" class="text-decoration-none text-muted">Projects</a></li>
                <li class="breadcrumb-item"><a asp-controller="Projects" asp-action="Index" asp-route-sisterConcern="@sisterConcern" class="text-decoration-none text-muted">@sisterConcern</a></li>
                <li class="breadcrumb-item active text-primary fw-semibold" aria-current="page">@b.Name</li>
            </ol>
        </nav>
    </div>
</section>

<!-- Property Header & Image Gallery -->
<section class="py-5">
    <div class="container">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <span class="badge bg-primary px-3 py-2"><i class="bi bi-building me-1"></i>@sisterConcern</span>
                    <span class="badge badge-status-@(b.Status.ToString().ToLower()) px-3 py-2">@b.Status</span>
                    <span class="badge bg-secondary bg-opacity-10 text-body border px-3 py-2">@(b.PropertyType ?? "Residential")</span>
                    @if (b.CompletionYear.HasValue)
                    {
                        <span class="badge bg-dark bg-opacity-75 text-white px-3 py-2">Est. @b.CompletionYear</span>
                    }
                </div>
                <h1 class="display-4 fw-bold mb-1 font-serif">@b.Name</h1>
                <p class="text-muted lead fs-6 mb-0"><i class="bi bi-geo-alt-fill text-primary me-2"></i>@b.Address</p>
            </div>

            <div class="text-md-end">
                <span class="text-muted small d-block text-uppercase tracking-wider">Starting Price</span>
                <span class="display-6 fw-bold text-primary font-serif">@priceFormatted</span>
            </div>
        </div>

        <!-- Swiper.js Gallery & Synchronized Thumbs -->
        <div class="glass-card p-3 shadow-lg mb-5">
            <div class="swiper swiper-details-main" style="height: 520px; border-radius: 0.75rem; overflow: hidden;">
                <div class="swiper-wrapper">
                    @foreach (var img in b.Images.OrderBy(i => i.DisplayOrder))
                    {
                        <div class="swiper-slide position-relative">
                            <img src="@img.ImagePath" alt="@(img.Caption ?? b.Name)" class="w-100 h-100 object-fit-cover" />
                            @if (!string.IsNullOrWhiteSpace(img.Caption))
                            {
                                <div class="position-absolute bottom-0 start-0 end-0 p-3 bg-dark bg-opacity-75 text-white small">
                                    <i class="bi bi-camera me-1 text-primary"></i>@img.Caption
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="swiper-button-next text-white"></div>
                <div class="swiper-button-prev text-white"></div>
                <div class="swiper-pagination"></div>
            </div>

            <div class="swiper swiper-details-thumbs swiper-thumbs-gallery">
                <div class="swiper-wrapper">
                    @foreach (var img in b.Images.OrderBy(i => i.DisplayOrder))
                    {
                        <div class="swiper-slide">
                            <img src="@img.ImagePath" alt="Thumbnail" class="w-100 h-100 object-fit-cover" />
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="row g-5">
            <!-- Left Column: Specs, Description, Features, Map -->
            <div class="col-lg-8">
                <!-- Specs Bar -->
                <div class="glass-card p-4 mb-4">
                    <h5 class="fw-bold mb-3 border-bottom pb-2 font-serif">Architectural Specifications</h5>
                    <div class="row g-3 text-center text-sm-start">
                        <div class="col-6 col-sm-3">
                            <span class="text-muted small d-block">Sister Concern</span>
                            <strong class="text-primary">@sisterConcern</strong>
                        </div>
                        <div class="col-6 col-sm-3">
                            <span class="text-muted small d-block">Status</span>
                            <strong class="text-body">@b.Status</strong>
                        </div>
                        <div class="col-6 col-sm-3">
                            <span class="text-muted small d-block">Completion</span>
                            <strong class="text-body">@(b.CompletionYear.HasValue ? b.CompletionYear.ToString() : "Ongoing")</strong>
                        </div>
                        <div class="col-6 col-sm-3">
                            <span class="text-muted small d-block">Total Residences</span>
                            <strong class="text-body">@(b.TotalUnits.HasValue ? $"{b.TotalUnits} Units" : "Custom")</strong>
                        </div>
                    </div>
                </div>

                <!-- Rich Text Description -->
                <div class="glass-card p-4 p-lg-5 mb-4">
                    <h4 class="fw-bold mb-4 font-serif">Design Narrative & Features</h4>
                    <div class="text-muted lh-lg">
                        @Html.Raw(b.LongDescription)
                    </div>
                </div>

                <!-- Structural Features -->
                @if (b.FeatureList.Any())
                {
                    <div class="glass-card p-4 p-lg-5 mb-4">
                        <h4 class="fw-bold mb-3 font-serif"><i class="bi bi-layers-half text-primary me-2"></i>Structural & Sustainable Engineering</h4>
                        <p class="text-muted small mb-4">Engineered to exceed international seismic, acoustic, and thermal envelope standards.</p>
                        
                        <div class="row g-3">
                            @foreach (var feat in b.FeatureList)
                            {
                                <div class="col-md-6">
                                    <div class="d-flex align-items-center gap-3 p-3 rounded-3 bg-body border">
                                        <i class="bi bi-shield-check text-primary fs-4"></i>
                                        <span class="fw-medium">@feat</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Leaflet Interactive Map & Nearby Amenities -->
                <div class="glass-card p-4 p-lg-5 mb-4">
                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-3">
                        <div>
                            <h4 class="fw-bold mb-1 font-serif"><i class="bi bi-geo-alt-fill text-primary me-2"></i>Location & Connectivity</h4>
                            <p class="text-muted small mb-0">Interactive Leaflet map centered at @b.Address</p>
                        </div>
                    </div>

                    <!-- Amenity Category Filters -->
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <span class="text-muted small align-self-center me-2">Nearby Amenities:</span>
                        <span class="amenity-chip badge bg-primary text-white active" data-type="all"><i class="bi bi-grid"></i> All</span>
                        <span class="amenity-chip badge bg-secondary bg-opacity-25 text-body" data-type="transit"><i class="bi bi-train-front"></i> Metro / Transit</span>
                        <span class="amenity-chip badge bg-secondary bg-opacity-25 text-body" data-type="education"><i class="bi bi-mortarboard"></i> Schools</span>
                        <span class="amenity-chip badge bg-secondary bg-opacity-25 text-body" data-type="hospital"><i class="bi bi-hospital"></i> Medical</span>
                        <span class="amenity-chip badge bg-secondary bg-opacity-25 text-body" data-type="lifestyle"><i class="bi bi-bag"></i> Luxury Retail</span>
                    </div>

                    <div id="propertyLeafletMap" class="map-container shadow-sm"></div>
                </div>
            </div>

            <!-- Right Column: Brochure Download CTA & Inquiry Form -->
            <div class="col-lg-4">
                <div class="sticky-top" style="top: 100px; z-index: 10;">
                    <!-- Brochure Download Card -->
                    <div class="glass-card p-4 mb-4 border-primary border-opacity-50">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <span class="p-3 rounded-3 bg-primary bg-opacity-10 text-primary fs-3">
                                <i class="bi bi-file-earmark-pdf-fill"></i>
                            </span>
                            <div>
                                <h5 class="fw-bold mb-0 font-serif">Property Brochure</h5>
                                <small class="text-muted">By @sisterConcern</small>
                            </div>
                        </div>
                        <p class="text-muted small mb-3 lh-base">
                            Download the certified architectural portfolio, high-resolution floor plans, and engineering specifications.
                        </p>
                        <a asp-action="DownloadBrochure" asp-route-id="@b.Id" class="btn btn-primary w-100 rounded-pill py-3 fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-download"></i> Download Floorplans (PDF)
                        </a>
                    </div>

                    <!-- Direct Inquiry Form -->
                    <div class="glass-card p-4">
                        <h5 class="fw-bold mb-1 font-serif">Inquire About This Property</h5>
                        <p class="text-muted small mb-3">Direct inquiry to <strong>@sisterConcern</strong>.</p>

                        <form class="ajax-inquiry-form">
                            <input type="hidden" name="PreferredProjectSlug" value="@b.Slug" />
                            <input type="hidden" name="TargetedConcern" value="@sisterConcern" />
                            <input type="hidden" name="Subject" value="Inquiry Regarding @b.Name" />

                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Your Name *</label>
                                <input type="text" name="ClientName" class="form-control rounded-3 py-2" placeholder="Full name" required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Email Address *</label>
                                <input type="email" name="EmailAddress" class="form-control rounded-3 py-2" placeholder="email@address.com" required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Phone Number</label>
                                <input type="tel" name="PhoneNumber" class="form-control rounded-3 py-2" placeholder="+1 (555) 000-0000" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Message</label>
                                <textarea name="Message" class="form-control rounded-3" rows="3" placeholder="Specify questions or viewing dates..." required></textarea>
                            </div>

                            <button type="submit" class="btn btn-outline-primary w-100 rounded-pill py-3 fw-bold">
                                <i class="bi bi-send-fill me-2"></i>Send Inquiry to @sisterConcern
                            </button>
                            <div class="inquiry-alert-box d-none"></div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Similar Projects Section -->
        @if (Model.SimilarProjects.Any())
        {
            <div class="mt-5 pt-5 border-top" data-aos="fade-up">
                <div class="d-flex justify-content-between align-items-end mb-4">
                    <div>
                        <span class="badge-editorial mb-2">Similar Portfolio</span>
                        <h3 class="fw-bold mb-0 font-serif">Complementary Recent Group Works</h3>
                    </div>
                    <a asp-action="Index" class="btn btn-outline-primary rounded-pill px-4">Browse All Projects &rarr;</a>
                </div>

                <div class="row g-4">
                    @foreach (var sim in Model.SimilarProjects)
                    {
                        <div class="col-md-4">
                            <div class="card h-100 glass-card glass-card-hover border-0 overflow-hidden d-flex flex-column">
                                <div class="position-relative overflow-hidden" style="height: 200px;">
                                    <img src="@(sim.PrimaryImage?.ImagePath ?? "/images/properties/lumina-1.svg")" alt="@sim.Name" class="w-100 h-100 object-fit-cover" loading="lazy" />
                                    <div class="position-absolute top-0 start-0 m-3">
                                        <span class="badge badge-status-@(sim.Status.ToString().ToLower()) shadow-sm">@sim.Status</span>
                                    </div>
                                </div>
                                <div class="card-body p-4 d-flex flex-column">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="badge bg-secondary bg-opacity-10 text-body border small">@(sim.SisterConcern ?? "Recent Properties Ltd")</span>
                                        <span class="text-muted small">@(sim.PropertyType ?? "Residential")</span>
                                    </div>
                                    <h5 class="card-title fw-bold font-serif mb-2 fs-6">
                                        <a asp-action="Details" asp-route-slug="@sim.Slug" class="text-decoration-none text-body stretched-link">
                                            @sim.Name
                                        </a>
                                    </h5>
                                    <p class="text-muted small mb-3"><i class="bi bi-geo-alt me-1 text-primary"></i>@sim.Address</p>
                                    <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                                        <span class="fw-bold text-primary font-serif">@(sim.PriceStartingFrom.HasValue ? $"${sim.PriceStartingFrom:N0}" : "Price on Request")</span>
                                        <span class="btn btn-outline-primary btn-sm rounded-circle p-2"><i class="bi bi-chevron-right"></i></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const thumbsSwiper = new Swiper('.swiper-details-thumbs', {
                spaceBetween: 10,
                slidesPerView: 4,
                freeMode: true,
                watchSlidesProgress: true,
                breakpoints: {
                    640: { slidesPerView: 5 },
                    1024: { slidesPerView: 6 }
                }
            });

            const mainSwiper = new Swiper('.swiper-details-main', {
                spaceBetween: 10,
                navigation: {
                    nextEl: '.swiper-button-next',
                    prevEl: '.swiper-button-prev',
                },
                pagination: {
                    el: '.swiper-pagination',
                    clickable: true,
                },
                thumbs: {
                    swiper: thumbsSwiper,
                },
            });

            const lat = @b.Latitude;
            const lng = @b.Longitude;
            const propertyName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(b.Name));
            const address = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(b.Address));

            const propMap = L.map('propertyLeafletMap').setView([lat, lng], 15);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(propMap);

            const propertyMarker = L.marker([lat, lng]).addTo(propMap);
            propertyMarker.bindPopup(`<b>${propertyName}</b><br><small>${address}</small>`).openPopup();

            const amenities = [
                { type: 'transit', name: 'Metro Express Station', lat: lat + 0.0032, lng: lng + 0.0028, icon: '🚇' },
                { type: 'education', name: 'International Academy', lat: lat - 0.0025, lng: lng + 0.0041, icon: '🎓' },
                { type: 'hospital', name: 'University Medical Center', lat: lat + 0.0048, lng: lng - 0.0035, icon: '🏥' },
                { type: 'lifestyle', name: 'Luxury Retail & Dining', lat: lat - 0.0038, lng: lng - 0.0022, icon: '🛍️' }
            ];

            let amenityMarkers = [];

            function renderAmenityMarkers(filterType) {
                amenityMarkers.forEach(m => propMap.removeLayer(m));
                amenityMarkers = [];

                amenities.forEach(a => {
                    if (filterType === 'all' || a.type === filterType) {
                        const amMarker = L.circleMarker([a.lat, a.lng], {
                            radius: 8,
                            fillColor: '#0284c7',
                            color: '#ffffff',
                            weight: 2,
                            opacity: 1,
                            fillOpacity: 0.9
                        }).addTo(propMap);
                        amMarker.bindPopup(`<b>${a.icon} ${a.name}</b><br><small class="text-capitalize">Category: ${a.type}</small>`);
                        amenityMarkers.push(amMarker);
                    }
                });
            }

            renderAmenityMarkers('all');

            document.querySelectorAll('.amenity-chip').forEach(chip => {
                chip.addEventListener('click', () => {
                    document.querySelectorAll('.amenity-chip').forEach(c => {
                        c.classList.remove('bg-primary', 'text-white', 'active');
                        c.classList.add('bg-secondary', 'bg-opacity-25', 'text-body');
                    });
                    chip.classList.add('bg-primary', 'text-white', 'active');
                    chip.classList.remove('bg-secondary', 'bg-opacity-25', 'text-body');

                    const type = chip.getAttribute('data-type');
                    renderAmenityMarkers(type);
                });
            });
        });
    </script>
}
