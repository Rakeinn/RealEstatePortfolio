@model RealEstatePortfolio.Models.ViewModels.ProjectsFilterViewModel

@{
    ViewData["Title"] = "Recent Group Portfolio | Recent Properties, Living & Interior";
}

<section class="py-5 bg-body-tertiary border-bottom">
    <div class="container py-lg-3">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <span class="badge-editorial mb-2">Recent Group Portfolio</span>
                <h1 class="display-5 fw-bold mb-1 font-serif">Developments & Architectural Works</h1>
                <p class="text-muted mb-0">Explore master projects by Recent Properties Ltd, Recent Living Ltd, and Recent Living Interior.</p>
            </div>
            
            <!-- View Mode Switcher -->
            <div class="btn-group rounded-pill p-1 glass-card shadow-sm" role="group">
                <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 active" id="viewGridBtn">
                    <i class="bi bi-grid-fill me-1"></i> Grid Catalog
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" id="viewMapBtn">
                    <i class="bi bi-map-fill me-1"></i> Global Map View
                </button>
            </div>
        </div>
    </div>
</section>

<section class="py-4">
    <div class="container">
        <!-- Filter Bar -->
        <div class="glass-card p-4 mb-4 shadow-sm">
            <form id="filterForm" method="get" asp-action="Index">
                <div class="row g-3 align-items-center">
                    <div class="col-lg-3">
                        <div class="input-group">
                            <span class="input-group-text bg-body border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" id="filterSearch" name="SearchTerm" value="@Model.SearchTerm" class="form-control border-start-0 ps-0" placeholder="Search by name, city, feature..." />
                        </div>
                    </div>

                    <div class="col-sm-6 col-lg-3">
                        <select id="filterSisterConcern" name="SisterConcern" class="form-select">
                            <option value="">All Sister Concerns</option>
                            @foreach (var concern in Model.AvailableSisterConcerns)
                            {
                                <option value="@concern" selected="@(Model.SisterConcern == concern)">@concern</option>
                            }
                        </select>
                    </div>

                    <div class="col-sm-6 col-lg-2">
                        <select id="filterStatus" name="Status" class="form-select">
                            <option value="">All Statuses</option>
                            <option value="Upcoming" selected="@(Model.Status == RealEstatePortfolio.Models.Entities.ProjectStatus.Upcoming)">Upcoming</option>
                            <option value="Ongoing" selected="@(Model.Status == RealEstatePortfolio.Models.Entities.ProjectStatus.Ongoing)">Ongoing</option>
                            <option value="Completed" selected="@(Model.Status == RealEstatePortfolio.Models.Entities.ProjectStatus.Completed)">Completed</option>
                        </select>
                    </div>

                    <div class="col-sm-6 col-lg-2">
                        <select id="filterYear" name="CompletionYear" class="form-select">
                            <option value="">All Years</option>
                            @foreach (var yr in Model.AvailableYears)
                            {
                                <option value="@yr" selected="@(Model.CompletionYear == yr)">@yr</option>
                            }
                        </select>
                    </div>

                    <div class="col-sm-6 col-lg-2">
                        <select id="filterSort" name="SortBy" class="form-select">
                            <option value="newest" selected="@(Model.SortBy == "newest")">Newest First</option>
                            <option value="name_asc" selected="@(Model.SortBy == "name_asc")">Name (A-Z)</option>
                            <option value="price_asc" selected="@(Model.SortBy == "price_asc")">Price (Low to High)</option>
                            <option value="price_desc" selected="@(Model.SortBy == "price_desc")">Price (High to Low)</option>
                            <option value="year_desc" selected="@(Model.SortBy == "year_desc")">Completion Year</option>
                        </select>
                    </div>
                </div>

                <!-- Sister Concern Quick Filter Chips -->
                <div class="d-flex flex-wrap align-items-center gap-2 mt-3 pt-3 border-top">
                    <span class="text-muted small fw-semibold me-2">Sister Concern:</span>
                    <span class="badge concern-chip rounded-pill px-3 py-2 border @(string.IsNullOrEmpty(Model.SisterConcern) ? "active" : "bg-body text-body")" data-concern="">All Recent Group (@Model.TotalResultsCount)</span>
                    <span class="badge concern-chip rounded-pill px-3 py-2 border @(Model.SisterConcern == "Recent Properties Ltd" ? "active" : "bg-body text-body")" data-concern="Recent Properties Ltd">Recent Properties Ltd</span>
                    <span class="badge concern-chip rounded-pill px-3 py-2 border @(Model.SisterConcern == "Recent Living Ltd" ? "active" : "bg-body text-body")" data-concern="Recent Living Ltd">Recent Living Ltd</span>
                    <span class="badge concern-chip rounded-pill px-3 py-2 border @(Model.SisterConcern == "Recent Living Interior" ? "active" : "bg-body text-body")" data-concern="Recent Living Interior">Recent Living Interior</span>
                    
                    <button type="button" id="resetFiltersBtn" class="btn btn-link btn-sm text-decoration-none text-muted ms-auto">
                        <i class="bi bi-x-circle me-1"></i>Reset Filters
                    </button>
                </div>
            </form>
        </div>

        <!-- Skeleton Loader Container -->
        <div id="skeletonContainer" class="row g-4 d-none">
            @for (int i = 0; i < 6; i++)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="glass-card skeleton-card p-3">
                        <div class="skeleton-loader mb-3" style="height: 190px;"></div>
                        <div class="skeleton-loader mb-2" style="height: 20px; width: 55%;"></div>
                        <div class="skeleton-loader mb-2" style="height: 24px; width: 85%;"></div>
                        <div class="skeleton-loader" style="height: 16px; width: 40%;"></div>
                    </div>
                </div>
            }
        </div>

        <!-- Master Map View -->
        <div id="mapViewContainer" class="glass-card p-3 mb-5 d-none">
            <div class="d-flex justify-content-between align-items-center mb-3 px-2">
                <h5 class="fw-bold mb-0 font-serif"><i class="bi bi-geo-alt-fill text-primary me-2"></i>Global Project Locations</h5>
                <span class="badge bg-primary rounded-pill px-3 py-2" id="mapProjectCount">@Model.Projects.Count Landmarks Pinned</span>
            </div>
            <div id="masterLeafletMap" style="height: 550px; width: 100%; border-radius: 0.75rem;"></div>
        </div>

        <!-- Grid View Results -->
        <div id="projectsGrid" class="row g-4">
            @if (!Model.Projects.Any())
            {
                <div class="col-12 text-center py-5">
                    <div class="p-5 glass-card max-w-500 mx-auto">
                        <i class="bi bi-search fs-1 text-muted mb-3 d-block"></i>
                        <h4 class="fw-bold font-serif">No Matching Developments</h4>
                        <p class="text-muted small">Try adjusting your filters or selecting another sister concern.</p>
                        <a asp-action="Index" class="btn btn-primary rounded-pill px-4">Reset Filters</a>
                    </div>
                </div>
            }
            else
            {
                @foreach (var p in Model.Projects)
                {
                    <div class="col-md-6 col-lg-4 project-item" data-aos="fade-up">
                        <div class="card h-100 glass-card glass-card-hover border-0 overflow-hidden d-flex flex-column">
                            <div class="position-relative overflow-hidden" style="height: 240px;">
                                <img src="@(p.PrimaryImage?.ImagePath ?? "/images/properties/lumina-1.svg")" alt="@p.Name" class="w-100 h-100 object-fit-cover" loading="lazy" />
                                <div class="position-absolute top-0 start-0 m-3">
                                    <span class="badge badge-status-@(p.Status.ToString().ToLower()) shadow-sm">@p.Status</span>
                                </div>
                                @if (p.CompletionYear.HasValue)
                                {
                                    <div class="position-absolute top-0 end-0 m-3">
                                        <span class="badge bg-dark bg-opacity-75 text-white shadow-sm">Est. @p.CompletionYear</span>
                                    </div>
                                }
                            </div>

                            <div class="card-body p-4 d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge bg-secondary bg-opacity-10 text-body border small">@(p.SisterConcern ?? "Recent Properties Ltd")</span>
                                    <span class="text-muted small">@(p.PropertyType ?? "Residential")</span>
                                </div>

                                <h5 class="card-title fw-bold font-serif mb-2 fs-5">
                                    <a asp-action="Details" asp-route-slug="@p.Slug" class="text-decoration-none text-body stretched-link">
                                        @p.Name
                                    </a>
                                </h5>
                                <p class="text-muted small mb-3"><i class="bi bi-geo-alt me-1 text-primary"></i>@p.Address</p>

                                @if (p.FeatureList.Any())
                                {
                                    <div class="d-flex flex-wrap gap-1 mb-4">
                                        @foreach (var feat in p.FeatureList.Take(3))
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-body border border-secondary border-opacity-10 small fw-normal">@feat</span>
                                        }
                                    </div>
                                }

                                <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                                    <div>
                                        <span class="text-muted small d-block" style="font-size: 11px; text-transform: uppercase;">From</span>
                                        <span class="fw-bold text-primary fs-5 font-serif">@(p.PriceStartingFrom.HasValue ? $"${p.PriceStartingFrom:N0}" : "Price on Request")</span>
                                    </div>
                                    <span class="btn btn-outline-primary btn-sm rounded-circle p-2">
                                        <i class="bi bi-chevron-right"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            let masterMap = null;
            let mapMarkers = [];

            function initMasterMap(projects) {
                if (!masterMap) {
                    masterMap = L.map('masterLeafletMap').setView([25.0, 10.0], 2);
                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                        attribution: '&copy; OpenStreetMap contributors'
                    }).addTo(masterMap);
                }

                mapMarkers.forEach(m => masterMap.removeLayer(m));
                mapMarkers = [];

                const bounds = [];
                projects.forEach(p => {
                    if (p.latitude && p.longitude) {
                        const marker = L.marker([p.latitude, p.longitude]).addTo(masterMap);
                        marker.bindPopup(`
                            <div style="min-width: 190px;">
                                <img src="${p.primaryImage}" style="width: 100%; height: 90px; object-fit: cover; border-radius: 6px; margin-bottom: 6px;" />
                                <strong style="font-size: 14px;">${p.name}</strong><br>
                                <span class="badge bg-secondary mb-1" style="font-size: 10px;">${p.sisterConcern || 'Recent Group'}</span>
                                <span class="badge bg-primary mb-1" style="font-size: 10px;">${p.statusText}</span><br>
                                <small class="text-muted">${p.address || ''}</small><br>
                                <a href="/projects/${p.slug}" class="btn btn-sm btn-primary w-100 mt-2 text-white" style="font-size: 11px;">View Project</a>
                            </div>
                        `);
                        mapMarkers.push(marker);
                        bounds.push([p.latitude, p.longitude]);
                    }
                });

                if (bounds.length > 0) {
                    masterMap.fitBounds(bounds, { padding: [40, 40] });
                }
            }

            const viewGridBtn = document.getElementById('viewGridBtn');
            const viewMapBtn = document.getElementById('viewMapBtn');
            const projectsGrid = document.getElementById('projectsGrid');
            const mapViewContainer = document.getElementById('mapViewContainer');

            viewGridBtn.addEventListener('click', () => {
                viewGridBtn.classList.add('btn-primary', 'active');
                viewGridBtn.classList.remove('btn-outline-secondary');
                viewMapBtn.classList.remove('btn-primary', 'active');
                viewMapBtn.classList.add('btn-outline-secondary');

                projectsGrid.classList.remove('d-none');
                mapViewContainer.classList.add('d-none');
            });

            viewMapBtn.addEventListener('click', () => {
                viewMapBtn.classList.add('btn-primary', 'active');
                viewMapBtn.classList.remove('btn-outline-secondary');
                viewGridBtn.classList.remove('btn-primary', 'active');
                viewGridBtn.classList.add('btn-outline-secondary');

                mapViewContainer.classList.remove('d-none');
                projectsGrid.classList.add('d-none');

                setTimeout(() => {
                    masterMap.invalidateSize();
                }, 200);
            });

            const initialProjects = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Projects.Select(b => new {
                id = b.Id,
                name = b.Name,
                slug = b.Slug,
                address = b.Address,
                statusText = b.Status.ToString(),
                sisterConcern = b.SisterConcern ?? "Recent Properties Ltd",
                latitude = b.Latitude,
                longitude = b.Longitude,
                primaryImage = b.PrimaryImage?.ImagePath ?? "/images/properties/lumina-1.svg"
            })));
            initMasterMap(initialProjects);

            let debounceTimer;
            const filterSearch = document.getElementById('filterSearch');
            const filterSisterConcern = document.getElementById('filterSisterConcern');
            const filterStatus = document.getElementById('filterStatus');
            const filterYear = document.getElementById('filterYear');
            const filterSort = document.getElementById('filterSort');
            const skeletonContainer = document.getElementById('skeletonContainer');

            async function triggerFilter() {
                const search = filterSearch.value;
                const concern = filterSisterConcern.value;
                const status = filterStatus.value;
                const year = filterYear.value;
                const sort = filterSort.value;

                projectsGrid.classList.add('d-none');
                skeletonContainer.classList.remove('d-none');

                const params = new URLSearchParams();
                if (search) params.append('searchTerm', search);
                if (concern) params.append('sisterConcern', concern);
                if (status) params.append('status', status);
                if (year) params.append('completionYear', year);
                if (sort) params.append('sortBy', sort);

                try {
                    const res = await fetch(`/Projects/FilterApi?${params.toString()}`);
                    const data = await res.json();

                    renderProjects(data.projects);
                    initMasterMap(data.projects);
                    document.getElementById('mapProjectCount').textContent = `${data.count} Landmarks Pinned`;
                } catch (err) {
                    console.error('Filter request failed', err);
                } finally {
                    skeletonContainer.classList.add('d-none');
                    if (!mapViewContainer.classList.contains('d-none')) {
                        projectsGrid.classList.add('d-none');
                    } else {
                        projectsGrid.classList.remove('d-none');
                    }
                }
            }

            function renderProjects(projects) {
                if (!projects || projects.length === 0) {
                    projectsGrid.innerHTML = `
                        <div class="col-12 text-center py-5">
                            <div class="p-5 glass-card max-w-500 mx-auto">
                                <i class="bi bi-search fs-1 text-muted mb-3 d-block"></i>
                                <h4 class="fw-bold font-serif">No Matching Developments</h4>
                                <p class="text-muted small">Try adjusting your filters or selecting another sister concern.</p>
                            </div>
                        </div>`;
                    return;
                }

                let html = '';
                projects.forEach(p => {
                    const priceFormatted = p.priceStartingFrom ? `$${Number(p.priceStartingFrom).toLocaleString()}` : 'Price on Request';
                    const statusClass = (p.statusText || '').toLowerCase();
                    const features = (p.structuralFeatures || '').split(',').map(f => f.trim()).filter(f => f.length > 0).slice(0, 3);
                    const featuresHtml = features.map(f => `<span class="badge bg-secondary bg-opacity-10 text-body border border-secondary border-opacity-10 small fw-normal">${f}</span>`).join(' ');

                    html += `
                        <div class="col-md-6 col-lg-4 project-item">
                            <div class="card h-100 glass-card glass-card-hover border-0 overflow-hidden d-flex flex-column">
                                <div class="position-relative overflow-hidden" style="height: 240px;">
                                    <img src="${p.primaryImage}" alt="${p.name}" class="w-100 h-100 object-fit-cover" loading="lazy" />
                                    <div class="position-absolute top-0 start-0 m-3">
                                        <span class="badge badge-status-${statusClass} shadow-sm">${p.statusText}</span>
                                    </div>
                                    ${p.completionYear ? `<div class="position-absolute top-0 end-0 m-3"><span class="badge bg-dark bg-opacity-75 text-white shadow-sm">Est. ${p.completionYear}</span></div>` : ''}
                                </div>
                                <div class="card-body p-4 d-flex flex-column">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="badge bg-secondary bg-opacity-10 text-body border small">${p.sisterConcern || 'Recent Properties Ltd'}</span>
                                        <span class="text-muted small">${p.propertyType || 'Residential'}</span>
                                    </div>
                                    <h5 class="card-title fw-bold font-serif mb-2 fs-5">
                                        <a href="/projects/${p.slug}" class="text-decoration-none text-body stretched-link">${p.name}</a>
                                    </h5>
                                    <p class="text-muted small mb-3"><i class="bi bi-geo-alt me-1 text-primary"></i>${p.address || ''}</p>
                                    <div class="d-flex flex-wrap gap-1 mb-4">${featuresHtml}</div>
                                    <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                                        <div>
                                            <span class="text-muted small d-block" style="font-size: 11px; text-transform: uppercase;">From</span>
                                            <span class="fw-bold text-primary fs-5 font-serif">${priceFormatted}</span>
                                        </div>
                                        <span class="btn btn-outline-primary btn-sm rounded-circle p-2">
                                            <i class="bi bi-chevron-right"></i>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>`;
                });

                projectsGrid.innerHTML = html;
            }

            filterSearch.addEventListener('input', () => {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(triggerFilter, 300);
            });

            filterSisterConcern.addEventListener('change', triggerFilter);
            filterStatus.addEventListener('change', triggerFilter);
            filterYear.addEventListener('change', triggerFilter);
            filterSort.addEventListener('change', triggerFilter);

            document.querySelectorAll('.concern-chip').forEach(chip => {
                chip.addEventListener('click', () => {
                    document.querySelectorAll('.concern-chip').forEach(c => {
                        c.classList.remove('active');
                        c.classList.add('bg-body', 'text-body');
                    });
                    chip.classList.add('active');
                    chip.classList.remove('bg-body', 'text-body');

                    filterSisterConcern.value = chip.getAttribute('data-concern');
                    triggerFilter();
                });
            });

            document.getElementById('resetFiltersBtn').addEventListener('click', () => {
                filterSearch.value = '';
                filterSisterConcern.value = '';
                filterStatus.value = '';
                filterYear.value = '';
                filterSort.value = 'newest';
                document.querySelectorAll('.concern-chip').forEach(c => {
                    c.classList.remove('active');
                    c.classList.add('bg-body', 'text-body');
                });
                document.querySelector('.concern-chip[data-concern=""]').classList.add('active');
                triggerFilter();
            });
        });
    </script>
}
