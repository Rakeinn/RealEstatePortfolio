@using Microsoft.AspNetCore.Identity
@using RealEstatePortfolio.Models.Entities
@inject SignInManager<ApplicationUser> SignInManager

<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["SeoTitle"] ?? "Recent Group | Premier Architecture, Living & Interiors")</title>
    <meta name="description" content="@(ViewData["SeoDescription"] ?? "Recent Group unites Recent Properties Ltd, Recent Living Ltd, and Recent Living Interior to deliver visionary master developments, modern residential sanctuaries, and bespoke turnkey interiors.")" />
    
    <!-- OpenGraph Tags -->
    <meta property="og:title" content="@(ViewData["SeoTitle"] ?? "Recent Group Portfolio")" />
    <meta property="og:description" content="@(ViewData["SeoDescription"] ?? "Recent Group - Recent Properties Ltd, Recent Living Ltd, Recent Living Interior.")" />
    <meta property="og:image" content="@(ViewData["OgImage"] ?? "/images/properties/lumina-1.svg")" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Google Fonts & Bootstrap 5.3 -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..800;1,400..800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- AOS CSS -->
    <link href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" rel="stylesheet">
    
    <!-- Swiper.js CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

    <!-- Leaflet.js CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

    <!-- Custom Theme Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Main Header & Navigation -->
    <nav class="navbar navbar-expand-lg glass-nav sticky-top py-3">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2 text-decoration-none text-body" asp-controller="Home" asp-action="Index">
                <img src="/images/logo.png" alt="Recent Group Logo" style="height: 42px; object-fit: contain;" class="rounded-2" />
                <span class="fw-bold tracking-wider fs-5 lh-1"><span class="text-primary">RECENT</span> <span class="text-success">GROUP</span></span>
            </a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                <i class="bi bi-list fs-2"></i>
            </button>

            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-lg-2">
                    <li class="nav-item">
                        <a class="nav-link rounded-pill @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link rounded-pill @(ViewContext.RouteData.Values["controller"]?.ToString() == "Projects" ? "active" : "")" asp-controller="Projects" asp-action="Index">Projects</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link rounded-pill @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "About" ? "active" : "")" asp-controller="Home" asp-action="About">About Us</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link rounded-pill @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Contact" ? "active" : "")" asp-controller="Home" asp-action="Contact">Contact</a>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-2">
                    <!-- Theme Toggle Switch -->
                    <button id="themeToggleBtn" class="btn btn-outline-secondary rounded-pill px-3 py-2 d-flex align-items-center gap-2" type="button" title="Toggle Light/Dark Theme">
                        <i id="themeIcon" class="bi bi-moon-stars-fill"></i>
                        <span id="themeText" class="d-none d-xl-inline small">Dark</span>
                    </button>

                    @if (SignInManager.IsSignedIn(User))
                    {
                        <div class="dropdown">
                            <button class="btn btn-primary rounded-pill px-3 py-2 dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
                                <i class="bi bi-shield-lock-fill"></i>
                                <span class="d-none d-sm-inline">Admin Portal</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end glass-card p-2 shadow-lg">
                                <li><a class="dropdown-item rounded-2 py-2" asp-controller="Admin" asp-action="Dashboard"><i class="bi bi-speedometer2 me-2"></i>Executive Analytics</a></li>
                                <li><a class="dropdown-item rounded-2 py-2" asp-controller="Admin" asp-action="Projects"><i class="bi bi-building me-2"></i>Portfolio CRUD</a></li>
                                <li><a class="dropdown-item rounded-2 py-2" asp-controller="Admin" asp-action="Content"><i class="bi bi-file-earmark-text me-2"></i>Dynamic CMS Engine</a></li>
                                <li><a class="dropdown-item rounded-2 py-2" asp-controller="Admin" asp-action="Leads"><i class="bi bi-inbox me-2"></i>Lead Inbox</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        <button type="submit" class="dropdown-item rounded-2 py-2 text-danger"><i class="bi bi-box-arrow-right me-2"></i>Sign Out</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="btn btn-outline-primary rounded-pill px-3 py-2" asp-controller="Account" asp-action="Login">
                            <i class="bi bi-lock-fill me-1"></i> Admin Portal
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content Body -->
    <main role="main" class="flex-grow-1">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-success alert-dismissible fade show glass-card border-success" role="alert">
                    <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-danger alert-dismissible fade show glass-card border-danger" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }

        @RenderBody()
    </main>

    <!-- Corporate Footer -->
    <footer class="glass-nav border-top mt-5 py-5">
        <div class="container">
            <div class="row g-4">
                <!-- Group Identity -->
                <div class="col-lg-3">
                    <a class="d-flex align-items-center gap-2 text-decoration-none text-body mb-3" asp-controller="Home" asp-action="Index">
                        <img src="/images/logo.png" alt="Recent Group Logo" style="height: 44px; object-fit: contain;" class="rounded-2" />
                        <span class="fw-bold fs-4"><span class="text-primary">RECENT</span> <span class="text-success">GROUP</span></span>
                    </a>
                    <p class="text-muted small pe-lg-2 lh-lg mb-3">
                        Recent Living Ltd. (<em>Better Lifestyle…</em>) & Recent Group — A trusted conglomerate creating thoughtfully designed homes and commercial spaces in Bangladesh.
                    </p>
                    <div class="d-flex gap-2 text-muted">
                        <span class="badge bg-body border py-2 px-3 small">Dhaka, Bangladesh</span>
                    </div>
                </div>

                <!-- Sister Concern 1: Recent Properties Ltd -->
                <div class="col-6 col-lg-3">
                    <h6 class="fw-bold text-uppercase small tracking-wider mb-2 text-primary">
                        <i class="bi bi-building me-1"></i> Recent Properties Ltd
                    </h6>
                    <p class="text-muted" style="font-size: 11px;">Land Development & Civil High-Rises</p>
                    <ul class="list-unstyled small d-flex flex-column gap-2 text-muted">
                        <li><a class="text-muted text-decoration-none" asp-controller="Projects" asp-action="Index" asp-route-sisterConcern="Recent Properties Ltd">Commercial Towers</a></li>
                        <li><a class="text-muted text-decoration-none" asp-controller="Projects" asp-action="Index" asp-route-sisterConcern="Recent Properties Ltd">Waterfront Landmarks</a></li>
                        <li><a class="text-muted text-decoration-none" asp-controller="Projects" asp-action="Index" asp-route-sisterConcern="Recent Properties Ltd">Land Acquisitions</a></li>
                    </ul>
                </div>

                <!-- Sister Concern 2: Recent Living Ltd -->
                <div class="col-6 col-lg-3">
                    <h6 class="fw-bold text-uppercase small tracking-wider mb-2 text-success">
                        <i class="bi bi-houses me-1"></i> Recent Living Ltd
                    </h6>
                    <p class="text-muted" style="font-size: 11px;">Modern Residential & Eco-Communities</p>
                    <ul class="list-unstyled small d-flex flex-column gap-2 text-muted">
                        <li><a class="text-muted text-decoration-none" asp-controller="Projects" asp-action="Index" asp-route-sisterConcern="Recent Living Ltd">Smart Condominiums</a></li>
                        <li><a class="text-muted text-decoration-none" asp-controller="Projects" asp-action="Index" asp-route-sisterConcern="Recent Living Ltd">Biophilic Sanctuaries</a></li>
                        <li><a class="text-muted text-decoration-none" asp-controller="Projects" asp-action="Index" asp-route-sisterConcern="Recent Living Ltd">Duplex Sky Homes</a></li>
                    </ul>
                </div>

                <!-- Sister Concern 3: Recent Living Interior -->
                <div class="col-lg-3">
                    <h6 class="fw-bold text-uppercase small tracking-wider mb-2 text-warning">
                        <i class="bi bi-palette me-1"></i> Recent Living Interior
                    </h6>
                    <p class="text-muted" style="font-size: 11px;">Interior Architecture & Turnkey Fit-Outs</p>
                    <ul class="list-unstyled small d-flex flex-column gap-2 text-muted mb-3">
                        <li><a class="text-muted text-decoration-none" asp-controller="Projects" asp-action="Index" asp-route-sisterConcern="Recent Living Interior">Bespoke Living Salons</a></li>
                        <li><a class="text-muted text-decoration-none" asp-controller="Projects" asp-action="Index" asp-route-sisterConcern="Recent Living Interior">Artisanal Joinery & Decor</a></li>
                        <li><a class="text-muted text-decoration-none" asp-controller="Projects" asp-action="Index" asp-route-sisterConcern="Recent Living Interior">Turnkey Penthouse Fit-Outs</a></li>
                    </ul>
                    <div class="border-top pt-2">
                        <small class="text-muted d-block"><i class="bi bi-envelope me-1 text-primary"></i>info@recentgroup.com</small>
                        <small class="text-muted d-block"><i class="bi bi-telephone me-1 text-primary"></i>+1 (212) 555-0198</small>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center border-top pt-4 mt-4 text-muted small">
                <p class="mb-0">&copy; @DateTime.UtcNow.Year Recent Group. All Rights Reserved. (Recent Properties Ltd • Recent Living Ltd • Recent Living Interior)</p>
                <div class="d-flex gap-3 mt-2 mt-sm-0">
                    <span class="text-muted">ISO 9001 Certified</span>
                    <span class="text-muted">LEED Platinum Accredited</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5.3 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

    <!-- AOS JS -->
    <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>

    <!-- Swiper.js JS -->
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

    <!-- Leaflet.js JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

    <!-- Site Core JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
