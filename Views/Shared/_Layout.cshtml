@using Microsoft.AspNetCore.Identity
@using RealEstatePortfolio.Models.Entities
@inject SignInManager<ApplicationUser> SignInManager

<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["SeoTitle"] ?? "Recent Group | Premier Architecture, Living & Interiors")</title>
    <meta name="description" content="@(ViewData["SeoDescription"] ?? "Recent Group unites Recent Properties Ltd, Recent Living Ltd, and Recent Living Interior to deliver visionary master developments, modern residential sanctuaries, and bespoke turnkey interiors.")" />
    
    <!-- OpenGraph Tags -->
    <meta property="og:title" content="@(ViewData["SeoTitle"] ?? "Recent Group Portfolio")" />
    <meta property="og:description" content="@(ViewData["SeoDescription"] ?? "Recent Group - Recent Properties Ltd, Recent Living Ltd, Recent Living Interior.")" />
    <meta property="og:image" content="@(ViewData["OgImage"] ?? "/images/properties/lumina-1.svg")" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Favicon & Icons -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />

    <!-- Google Fonts & Bootstrap 5.3 -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..800;1,400..800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- AOS CSS -->
    <link href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" rel="stylesheet">
    
    <!-- Swiper.js CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

    <!-- Leaflet.js CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

    <!-- Custom Theme Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Top Scroll Progress Indicator -->
    <div id="scrollProgressBar" class="scroll-progress-bar" aria-hidden="true"></div>

    <!-- Unified Animated Aurora Ambient Canvas for Frosted Glass -->
    <div class="ambient-aurora-bg" aria-hidden="true">
        <div class="aurora-orb aurora-orb-1"></div>
        <div class="aurora-orb aurora-orb-2"></div>
        <div class="aurora-orb aurora-orb-3"></div>
    </div>

    <!-- Main Header & Navigation -->
    <nav class="navbar navbar-expand-lg glass-nav sticky-top py-3">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2 text-decoration-none text-body" asp-controller="Home" asp-action="Index">
                <img src="/images/logo.png" asp-append-version="true" alt="Recent Group Logo" style="height: 54px; width: auto; object-fit: contain;" class="brand-logo-img" />
                <span class="fw-bold tracking-wider fs-5 lh-1"><span class="text-primary">RECENT</span> <span class="text-success">GROUP</span></span>
            </a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                <i class="bi bi-list fs-2"></i>
            </button>

            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-lg-2">
                    <li class="nav-item">
                        <a class="nav-link rounded-pill @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link rounded-pill @(ViewContext.RouteData.Values["controller"]?.ToString() == "Projects" ? "active" : "")" asp-controller="Projects" asp-action="Index">Projects</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link rounded-pill @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "About" ? "active" : "")" asp-controller="Home" asp-action="About">About Us</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link rounded-pill @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Contact" ? "active" : "")" asp-controller="Home" asp-action="Contact">Contact</a>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-2 mt-3 mt-lg-0">
                    <!-- Theme Toggle Switch for Dark/Light Mode -->
                    <button id="themeToggleBtn" class="btn btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center" type="button" title="Toggle Theme" style="width: 40px; height: 40px; padding: 0;">
                        <i id="themeIcon" class="bi bi-moon-stars-fill"></i>
                    </button>

                    @if (SignInManager.IsSignedIn(User))
                    {
                        <div class="dropdown">
                            <button class="btn btn-primary rounded-pill px-3 py-2 dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-fill-gear"></i>
                                <span>Admin</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end glass-card p-2 shadow-lg">
                                <li><a class="dropdown-item rounded-2 py-2" asp-controller="Admin" asp-action="Dashboard"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
                                <li><a class="dropdown-item rounded-2 py-2" asp-controller="Admin" asp-action="Projects"><i class="bi bi-building me-2"></i>Projects</a></li>
                                <li><a class="dropdown-item rounded-2 py-2" asp-controller="Admin" asp-action="Content"><i class="bi bi-file-earmark-text me-2"></i>Page Content</a></li>
                                <li><a class="dropdown-item rounded-2 py-2" asp-controller="Admin" asp-action="Leads"><i class="bi bi-inbox me-2"></i>Inquiries</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        <button type="submit" class="dropdown-item rounded-2 py-2 text-danger"><i class="bi bi-box-arrow-right me-2"></i>Sign Out</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="btn btn-primary rounded-pill px-4 py-2 small fw-semibold shadow-sm d-inline-flex align-items-center gap-2" asp-controller="Account" asp-action="Login">
                            <i class="bi bi-box-arrow-in-right"></i>
                            <span>Log in</span>
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content Body -->
    <main role="main" class="flex-grow-1">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-success alert-dismissible fade show glass-card border-success" role="alert">
                    <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-danger alert-dismissible fade show glass-card border-danger" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }

        @RenderBody()
    </main>

    <!-- Simplified Human-Crafted Footer -->
    <footer class="glass-nav border-top mt-5 py-5 site-footer">
        <div class="container">
            <div class="row g-4 justify-content-between align-items-start">
                <!-- 1. Brand Identity -->
                <div class="col-lg-5 col-md-6">
                    <a class="d-inline-flex align-items-center gap-3 text-decoration-none text-body mb-3" asp-controller="Home" asp-action="Index">
                        <img src="/images/logo.png" asp-append-version="true" alt="Recent Living Ltd Logo" style="height: 60px; width: auto; object-fit: contain;" class="brand-logo-img" />
                        <div>
                            <span class="fw-bold fs-5 tracking-wider lh-1 d-block"><span class="text-primary">RECENT</span> <span class="text-success">GROUP</span></span>
                            <small class="text-muted" style="font-size: 11px;">Recent Living Ltd. &bull; <em>Better Lifestyle…</em></small>
                        </div>
                    </a>
                    <p class="text-muted small pe-lg-4 lh-lg mb-3">
                        Creating thoughtfully designed homes and commercial spaces across Bangladesh that enrich people's lives and contribute to better communities through quality, trust, and lasting value.
                    </p>
                    <div class="d-flex flex-wrap gap-2">
                        <span class="badge bg-body border text-muted py-2 px-3 small"><i class="bi bi-geo-alt-fill text-danger me-1"></i>Dhaka, Bangladesh</span>
                    </div>
                </div>

                <!-- 2. Quick Navigation -->
                <div class="col-lg-3 col-6">
                    <h6 class="fw-bold text-uppercase small tracking-wider mb-3 font-serif">Quick Links</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2 text-muted mb-0">
                        <li><a class="text-muted text-decoration-none footer-link" asp-controller="Home" asp-action="Index"><i class="bi bi-chevron-right small me-1"></i>Home</a></li>
                        <li><a class="text-muted text-decoration-none footer-link" asp-controller="Projects" asp-action="Index"><i class="bi bi-chevron-right small me-1"></i>Our Projects</a></li>
                        <li><a class="text-muted text-decoration-none footer-link" asp-controller="Home" asp-action="About"><i class="bi bi-chevron-right small me-1"></i>About Us</a></li>
                        <li><a class="text-muted text-decoration-none footer-link" asp-controller="Home" asp-action="Living"><i class="bi bi-chevron-right small me-1"></i>Recent Living Ltd.</a></li>
                        <li><a class="text-muted text-decoration-none footer-link" asp-controller="Home" asp-action="Contact"><i class="bi bi-chevron-right small me-1"></i>Contact Us</a></li>
                    </ul>
                </div>

                <!-- 3. Get in Touch -->
                <div class="col-lg-3 col-6">
                    <h6 class="fw-bold text-uppercase small tracking-wider mb-3 font-serif">Connect</h6>
                    <p class="text-muted small mb-3">
                        Interested in apartments or transparent Joint Venture landowner partnerships?
                    </p>
                    <a asp-controller="Home" asp-action="Contact" class="btn btn-primary rounded-pill px-4 py-2 small fw-semibold shadow-sm d-inline-flex align-items-center gap-2">
                        <i class="bi bi-envelope-fill"></i>
                        <span>Contact Us</span>
                    </a>
                </div>
            </div>

            <!-- Bottom Copyright Bar -->
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center border-top pt-4 mt-5 text-muted small">
                <p class="mb-0">&copy; @DateTime.UtcNow.Year Recent Living Ltd. (Tagline: <em>Better Lifestyle…</em>). All Rights Reserved.</p>
                <div class="mt-2 mt-sm-0 d-flex align-items-center gap-3">
                    <span class="text-muted small">Dhaka, Bangladesh</span>
                    <a asp-controller="Account" asp-action="Login" class="text-muted text-decoration-none small" style="opacity: 0.6;" title="Admin & Staff Login">
                        <i class="bi bi-lock me-1"></i>Staff
                    </a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Floating Back-to-Top Glass Pill -->
    <button type="button" id="backToTopBtn" class="back-to-top-glass" title="Back to Top" aria-label="Back to Top">
        <i class="bi bi-arrow-up"></i>
    </button>

    <!-- Bootstrap 5.3 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

    <!-- AOS JS -->
    <script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>

    <!-- Swiper.js JS -->
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

    <!-- Leaflet.js JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

    <!-- Site Core JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
