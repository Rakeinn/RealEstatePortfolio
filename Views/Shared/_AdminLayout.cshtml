@using Microsoft.AspNetCore.Identity
@using RealEstatePortfolio.Models.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Admin Dashboard") - EstateLuxe CMS</title>
    
    <!-- Bootstrap 5.3 & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- SortableJS -->
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>

    <!-- Quill.js Rich Text Editor -->
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>

    <!-- Leaflet.js -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <!-- Custom Theme Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-body-tertiary">
    <div class="d-flex min-vh-100">
        <!-- Sidebar -->
        <aside class="admin-sidebar d-none d-lg-flex flex-column p-3">
            <div class="d-flex align-items-center gap-2 px-2 py-2 mb-4">
                <img src="/images/logo.png" asp-append-version="true" alt="Recent Group Logo" style="height: 48px; width: auto; object-fit: contain;" class="brand-logo-img" />
                <span class="fw-bold fs-5 tracking-wide"><span class="text-primary">RECENT</span> <span class="text-success">ADMIN</span></span>
            </div>

            <nav class="nav flex-column gap-1 mb-auto">
                <a class="admin-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")" asp-controller="Admin" asp-action="Dashboard">
                    <i class="bi bi-speedometer2 fs-5"></i> Dashboard Analytics
                </a>
                <a class="admin-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Projects" ? "active" : "")" asp-controller="Admin" asp-action="Projects">
                    <i class="bi bi-building fs-5"></i> Manage Projects
                </a>
                <a class="admin-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "CreateProject" ? "active" : "")" asp-controller="Admin" asp-action="CreateProject">
                    <i class="bi bi-plus-circle fs-5"></i> Publish New Property
                </a>
                <a class="admin-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Content" ? "active" : "")" asp-controller="Admin" asp-action="Content">
                    <i class="bi bi-file-earmark-richtext fs-5"></i> Dynamic CMS Engine
                </a>
                <a class="admin-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Leads" ? "active" : "")" asp-controller="Admin" asp-action="Leads">
                    <i class="bi bi-inbox fs-5"></i> Lead Inbox
                </a>
                @if (User.IsInRole("Admin"))
                {
                    <a class="admin-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Users" ? "active" : "")" asp-controller="Admin" asp-action="Users">
                        <i class="bi bi-people fs-5"></i> User Roles & Staff
                    </a>
                }
            </nav>

            <hr class="my-3">
            <div class="px-2">
                <a class="btn btn-outline-secondary w-100 rounded-pill btn-sm d-flex align-items-center justify-content-center gap-2" asp-controller="Home" asp-action="Index" target="_blank">
                    <i class="bi bi-box-arrow-up-right"></i> View Public Site
                </a>
            </div>
        </aside>

        <!-- Main Content Area -->
        <div class="flex-grow-1 d-flex flex-column">
            <!-- Top Header -->
            <header class="glass-nav py-3 px-4 border-bottom d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-3">
                    <h5 class="mb-0 fw-bold">@(ViewData["Title"] ?? "Admin Control Panel")</h5>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <!-- Theme Toggle Switch -->
                    <button id="themeToggleBtn" class="btn btn-outline-secondary rounded-pill px-3 d-flex align-items-center gap-2" type="button">
                        <i id="themeIcon" class="bi bi-moon-stars-fill"></i>
                        <span id="themeText" class="d-none d-md-inline small">Dark</span>
                    </button>

                    <div class="dropdown">
                        <button class="btn btn-outline-primary rounded-pill px-3 dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
                            <i class="bi bi-person-badge"></i>
                            <span>@(User.Identity?.Name ?? "Admin")</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end glass-card p-2">
                            <li><a class="dropdown-item rounded-2 py-2" asp-controller="Home" asp-action="Index"><i class="bi bi-globe me-2"></i>Public Website</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item text-danger rounded-2 py-2"><i class="bi bi-box-arrow-right me-2"></i>Sign Out</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Body Container -->
            <main class="p-4 flex-grow-1">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show glass-card border-success mb-4" role="alert">
                        <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show glass-card border-danger mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                        @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Bootstrap 5.3 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
