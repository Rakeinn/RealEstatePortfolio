@model RealEstatePortfolio.Models.ViewModels.AdminProjectEditViewModel

@{
    ViewData["Title"] = $"Edit {Model.Name}";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Edit Project: @Model.Name</h4>
        <p class="text-muted small mb-0">Modify specifications, brochure PDFs, or coordinates.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ManageImages" asp-route-id="@Model.Id" class="btn btn-outline-info rounded-pill px-3">
            <i class="bi bi-images me-1"></i> Gallery & Reorder Photos
        </a>
        <a asp-action="Projects" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<form asp-action="EditProject" method="post" enctype="multipart/form-data" id="projectForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="BrochurePdfPath" />
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="row g-4">
        <!-- Left Column -->
        <div class="col-lg-8">
            <div class="glass-card p-4 mb-4">
                <h5 class="fw-bold mb-3 border-bottom pb-2">Core Specifications</h5>
                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Name" class="form-label small fw-semibold"></label>
                        <input asp-for="Name" class="form-control rounded-3" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label small fw-semibold"></label>
                        <select asp-for="Status" class="form-select rounded-3" asp-items="Html.GetEnumSelectList<RealEstatePortfolio.Models.Entities.ProjectStatus>()"></select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="SisterConcern" class="form-label small fw-semibold">Sister Concern / Division</label>
                        <select asp-for="SisterConcern" class="form-select rounded-3">
                            <option value="Recent Properties Ltd">Recent Properties Ltd (Land & Structures)</option>
                            <option value="Recent Living Ltd">Recent Living Ltd (Residential & Eco)</option>
                            <option value="Recent Living Interior">Recent Living Interior (Interior Design)</option>
                        </select>
                    </div>

                    <div class="col-12">
                        <label asp-for="Slug" class="form-label small fw-semibold">SEO URL Slug</label>
                        <div class="input-group">
                            <span class="input-group-text bg-body text-muted">/projects/</span>
                            <input asp-for="Slug" class="form-control rounded-end-3" required />
                        </div>
                        <span asp-validation-for="Slug" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Address" class="form-label small fw-semibold"></label>
                        <input asp-for="Address" class="form-control rounded-3" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="PropertyType" class="form-label small fw-semibold">Category / Project Type</label>
                        <select asp-for="PropertyType" class="form-select rounded-3">
                            <option value="Residential">Residential</option>
                            <option value="Commercial">Commercial</option>
                            <option value="Mix">Mix (Commercial + Residential)</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="HandoverDate" class="form-label small fw-semibold"></label>
                        <input asp-for="HandoverDate" class="form-control rounded-3" placeholder="e.g. Handover on December 2025" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="CompletionYear" class="form-label small fw-semibold"></label>
                        <input asp-for="CompletionYear" type="number" class="form-control rounded-3" />
                    </div>
                </div>
            </div>

            <!-- Property Highlights -->
            <div class="glass-card p-4 mb-4">
                <h5 class="fw-bold mb-3 border-bottom pb-2">Property Highlights</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Facing" class="form-label small fw-semibold"></label>
                        <input asp-for="Facing" class="form-control rounded-3" placeholder="e.g. East Facing" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Storied" class="form-label small fw-semibold"></label>
                        <input asp-for="Storied" class="form-control rounded-3" placeholder="e.g. B+G+ 08 Floors" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ApartmentSize" class="form-label small fw-semibold"></label>
                        <input asp-for="ApartmentSize" class="form-control rounded-3" placeholder="e.g. 1466 Sq. Ft. | 1133 Sq. Ft." />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="LandSize" class="form-label small fw-semibold"></label>
                        <input asp-for="LandSize" class="form-control rounded-3" placeholder="e.g. 8 Katha" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="TotalUnits" class="form-label small fw-semibold"></label>
                        <input asp-for="TotalUnits" type="number" class="form-control rounded-3" />
                    </div>
                </div>
            </div>

            <!-- Apartment Contains -->
            <div class="glass-card p-4 mb-4">
                <h5 class="fw-bold mb-3 border-bottom pb-2">Apartment Contains</h5>
                <label asp-for="ApartmentContains" class="form-label small fw-semibold">Room &amp; Space Breakdown (comma-separated):</label>
                <input asp-for="ApartmentContains" id="apartmentContainsInput" class="form-control rounded-3 mb-2" placeholder="03 Beds, 02 Bath (Attached) & 1 Common, 03 Balconies, Living, Dining, Kitchen" />
            </div>

            <!-- Rich Text Long Description (Quill.js) -->
            <div class="glass-card p-4 mb-4">
                <h5 class="fw-bold mb-3 border-bottom pb-2">Project Overview &amp; Description</h5>
                <div id="quillEditor" style="height: 240px; border-radius: 0.5rem;" class="bg-body">
                    @Html.Raw(Model.LongDescription)
                </div>
                <textarea asp-for="LongDescription" id="hiddenDescription" class="d-none"></textarea>
            </div>

            <!-- Common Features & Amenities -->
            <div class="glass-card p-4 mb-4">
                <h5 class="fw-bold mb-3 border-bottom pb-2">Common Features &amp; Amenities</h5>
                <label asp-for="StructuralFeatures" class="form-label small fw-semibold">Comma-Separated Features &amp; Amenities:</label>
                <input asp-for="StructuralFeatures" id="featuresInput" class="form-control rounded-3 mb-2" />
            </div>

            <!-- Neighborhood Connectivity -->
            <div class="glass-card p-4 mb-4">
                <h5 class="fw-bold mb-3 border-bottom pb-2">Neighborhood</h5>
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="NeighborhoodSchools" class="form-label small fw-semibold"></label>
                        <textarea asp-for="NeighborhoodSchools" rows="3" class="form-control rounded-3"></textarea>
                    </div>
                    <div class="col-12">
                        <label asp-for="NeighborhoodHospitals" class="form-label small fw-semibold"></label>
                        <textarea asp-for="NeighborhoodHospitals" rows="3" class="form-control rounded-3"></textarea>
                    </div>
                    <div class="col-12">
                        <label asp-for="NeighborhoodTransit" class="form-label small fw-semibold"></label>
                        <textarea asp-for="NeighborhoodTransit" rows="3" class="form-control rounded-3"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column -->
        <div class="col-lg-4">
            <!-- Coordinates Picker -->
            <div class="glass-card p-4 mb-4">
                <h5 class="fw-bold mb-2">Location Coordinates</h5>
                <div id="coordPickerMap" style="height: 200px; border-radius: 0.5rem;" class="mb-3"></div>
                <div class="row g-2">
                    <div class="col-6">
                        <label asp-for="Latitude" class="form-label small fw-semibold">Latitude</label>
                        <input asp-for="Latitude" id="latInput" type="number" step="0.000001" class="form-control rounded-3" required />
                    </div>
                    <div class="col-6">
                        <label asp-for="Longitude" class="form-label small fw-semibold">Longitude</label>
                        <input asp-for="Longitude" id="lngInput" type="number" step="0.000001" class="form-control rounded-3" required />
                    </div>
                </div>
            </div>

            <!-- PDF Brochure -->
            <div class="glass-card p-4 mb-4">
                <h5 class="fw-bold mb-2">Brochure (PDF)</h5>
                @if (!string.IsNullOrEmpty(Model.BrochurePdfPath))
                {
                    <div class="alert alert-info py-2 px-3 small d-flex align-items-center justify-content-between mb-3">
                        <span><i class="bi bi-file-earmark-pdf me-1"></i> Current Brochure Attached</span>
                        <a href="@Model.BrochurePdfPath" target="_blank" class="btn btn-sm btn-link p-0">View</a>
                    </div>
                }
                <label class="form-label small text-muted">Upload replacement PDF:</label>
                <input asp-for="BrochureFile" type="file" accept=".pdf" class="form-control rounded-3" />
            </div>

            <!-- Add More Images -->
            <div class="glass-card p-4 mb-4">
                <h5 class="fw-bold mb-2">Add Gallery Images</h5>
                <input asp-for="NewImages" type="file" multiple accept="image/*" class="form-control rounded-3 mb-2" />
                <small class="text-muted">You can drag and reorder existing images in the Gallery Manager.</small>
            </div>

            <!-- SEO Meta Tags -->
            <div class="glass-card p-4 mb-4">
                <h5 class="fw-bold mb-2">SEO Meta Data</h5>
                <div class="mb-3">
                    <label asp-for="SeoTitle" class="form-label small fw-semibold"></label>
                    <input asp-for="SeoTitle" maxlength="65" class="form-control rounded-3" />
                </div>
                <div>
                    <label asp-for="SeoDescription" class="form-label small fw-semibold"></label>
                    <textarea asp-for="SeoDescription" maxlength="160" rows="3" class="form-control rounded-3"></textarea>
                </div>
            </div>

            <button type="submit" class="btn btn-primary btn-lg rounded-pill w-100 py-3 fw-bold shadow">
                <i class="bi bi-check2-circle me-2"></i> Save Changes
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const quill = new Quill('#quillEditor', {
                theme: 'snow',
                modules: {
                    toolbar: [
                        [{ 'header': [1, 2, 3, false] }],
                        ['bold', 'italic', 'underline'],
                        [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                        ['link', 'blockquote', 'code-block'],
                        ['clean']
                    ]
                }
            });

            const form = document.getElementById('projectForm');
            form.addEventListener('submit', () => {
                document.getElementById('hiddenDescription').value = quill.root.innerHTML;
            });

            const initialLat = parseFloat(document.getElementById('latInput').value) || 40.7128;
            const initialLng = parseFloat(document.getElementById('lngInput').value) || -74.0060;

            const map = L.map('coordPickerMap').setView([initialLat, initialLng], 12);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            let marker = L.marker([initialLat, initialLng], { draggable: true }).addTo(map);

            function updateInputs(lat, lng) {
                document.getElementById('latInput').value = lat.toFixed(6);
                document.getElementById('lngInput').value = lng.toFixed(6);
            }

            map.on('click', (e) => {
                marker.setLatLng(e.latlng);
                updateInputs(e.latlng.lat, e.latlng.lng);
            });

            marker.on('dragend', (e) => {
                const pos = marker.getLatLng();
                updateInputs(pos.lat, pos.lng);
            });
        });
    </script>
}
