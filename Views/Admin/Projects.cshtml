@model List<RealEstatePortfolio.Models.Entities.Building>

@{
    ViewData["Title"] = "Manage Portfolio Projects";
    Layout = "_AdminLayout";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-1">Portfolio & Project Catalog</h4>
        <p class="text-muted small mb-0">Total of @Model.Count architectural developments registered.</p>
    </div>
    <a asp-action="CreateProject" class="btn btn-primary rounded-pill px-4">
        <i class="bi bi-plus-lg me-1"></i> Publish New Property
    </a>
</div>

<div class="glass-card p-4">
    <div class="table-responsive">
        <table class="table align-middle table-hover mb-0">
            <thead>
                <tr class="text-muted small text-uppercase">
                    <th>Property</th>
                    <th>Status</th>
                    <th>Type / Year</th>
                    <th>Price</th>
                    <th>Gallery Images</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <img src="@(p.PrimaryImage?.ImagePath ?? "/images/properties/lumina-1.svg")" alt="@p.Name" class="rounded-3 shadow-sm" style="width: 56px; height: 56px; object-fit: cover;" />
                                <div>
                                    <div class="fw-bold fs-6">@p.Name</div>
                                    <div class="d-flex align-items-center gap-2 mt-1">
                                        <span class="badge bg-secondary bg-opacity-25 text-body border" style="font-size: 10px;">@(p.SisterConcern ?? "Recent Properties Ltd")</span>
                                        <small class="text-muted"><i class="bi bi-link-45deg"></i> /projects/@p.Slug</small>
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="badge badge-status-@(p.Status.ToString().ToLower()) px-3 py-2">@p.Status</span>
                        </td>
                        <td>
                            <div class="fw-medium">@(p.PropertyType ?? "Residential")</div>
                            <small class="text-muted">@(p.CompletionYear.HasValue ? $"Est. {p.CompletionYear}" : "Underway")</small>
                        </td>
                        <td>
                            <div class="fw-bold text-primary">@(p.PriceStartingFrom.HasValue ? $"${p.PriceStartingFrom:N0}" : "On Request")</div>
                        </td>
                        <td>
                            <a asp-action="ManageImages" asp-route-id="@p.Id" class="btn btn-outline-info btn-sm rounded-pill px-3">
                                <i class="bi bi-images me-1"></i> @p.Images.Count Photos
                            </a>
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2">
                                <a asp-controller="Projects" asp-action="Details" asp-route-slug="@p.Slug" target="_blank" class="btn btn-outline-secondary btn-sm rounded-circle p-2" title="Preview Public Page">
                                    <i class="bi bi-eye-fill"></i>
                                </a>
                                <a asp-action="EditProject" asp-route-id="@p.Id" class="btn btn-outline-primary btn-sm rounded-circle p-2" title="Edit Details">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>
                                <form asp-action="DeleteProject" asp-route-id="@p.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you wish to delete this project? This will also remove its associated images.');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-circle p-2" title="Delete">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
