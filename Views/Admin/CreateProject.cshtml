@model RealEstatePortfolio.Models.ViewModels.AdminProjectEditViewModel

@{
    ViewData["Title"] = "Publish New Landmark Property";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Publish New Property</h4>
        <p class="text-muted small mb-0">Fill in the architectural specifications, coordinates, and upload floor plans.</p>
    </div>
    <a asp-action="Projects" class="btn btn-outline-secondary rounded-pill px-4">
        <i class="bi bi-arrow-left me-1"></i> Back to List
    </a>
</div>

<form asp-action="CreateProject" method="post" enctype="multipart/form-data" id="projectForm">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="row g-4">
        <!-- Left Column: Core Details & Rich Text -->
        <div class="col-lg-8">
            <div class="glass-card p-4 mb-4">
                <h5 class="fw-bold mb-3 border-bottom pb-2">Basic Information</h5>
                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Name" class="form-label small fw-semibold"></label>
                        <input asp-for="Name" id="projectNameInput" class="form-control rounded-3" placeholder="e.g. The Lumina Horizon Tower" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Status" class="form-label small fw-semibold"></label>
                        <select asp-for="Status" class="form-select rounded-3" asp-items="Html.GetEnumSelectList<RealEstatePortfolio.Models.Entities.ProjectStatus>()"></select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="SisterConcern" class="form-label small fw-semibold">Sister Concern / Division</label>
                        <select asp-for="SisterConcern" class="form-select rounded-3">
                            <option value="Recent Properties Ltd">Recent Properties Ltd (Land & Structures)</option>
                            <option value="Recent Living Ltd">Recent Living Ltd (Residential & Eco)</option>
                            <option value="Recent Living Interior">Recent Living Interior (Interior Design)</option>
                        </select>
                    </div>

                    <div class="col-12">
                        <label asp-for="Slug" class="form-label small fw-semibold">SEO URL Slug (e.g. /projects/the-lumina-horizon-tower)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-body text-muted">/projects/</span>
                            <input asp-for="Slug" id="projectSlugInput" class="form-control rounded-end-3" placeholder="the-lumina-horizon-tower" required />
                        </div>
                        <span asp-validation-for="Slug" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Address" class="form-label small fw-semibold"></label>
                        <input asp-for="Address" class="form-control rounded-3" placeholder="e.g. 520 West 28th Street, Chelsea, New York, NY" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PropertyType" class="form-label small fw-semibold">Category / Project Type</label>
                        <select asp-for="PropertyType" class="form-select rounded-3">
                            <option value="Residential">Residential</option>
                            <option value="Commercial">Commercial</option>
                            <option value="Mix">Mix</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CompletionYear" class="form-label small fw-semibold"></label>
                        <input asp-for="CompletionYear" type="number" class="form-control rounded-3" placeholder="2026" />
                    </div>
                </div>
            </div>

            <!-- Rich Text Long Description (Quill.js) -->
            <div class="glass-card p-4 mb-4">
                <h5 class="fw-bold mb-3 border-bottom pb-2">Architectural Vision & Long Description</h5>
                <label class="form-label small text-muted mb-2">Integrated Rich Text Editor for detailed design narrative:</label>
                <div id="quillEditor" style="height: 260px; border-radius: 0.5rem;" class="bg-body"></div>
                <textarea asp-for="LongDescription" id="hiddenDescription" class="d-none"></textarea>
            </div>

            <!-- Structural Features -->
            <div class="glass-card p-4 mb-4">
                <h5 class="fw-bold mb-3 border-bottom pb-2">Structural & Engineering Features</h5>
                <label asp-for="StructuralFeatures" class="form-label small fw-semibold">Structural Features (comma-separated):</label>
                <input asp-for="StructuralFeatures" id="featuresInput" class="form-control rounded-3 mb-2" placeholder="Seismic Grade 9 Dampers, Biophilic Hydroponic Facade, Private Helipad, Geothermal HVAC" />
                <div class="d-flex flex-wrap gap-1 mt-2">
                    <span class="text-muted small align-self-center me-1">Quick Add:</span>
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill feature-tag-btn">+ Seismic Grade Dampers</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill feature-tag-btn">+ Biophilic Facade</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill feature-tag-btn">+ Triple-Glazed Acoustic Glass</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill feature-tag-btn">+ Smart Robotic Parking</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill feature-tag-btn">+ Infinity Sky Pool</button>
                </div>
            </div>
        </div>

        <!-- Right Column: Interactive Map Coordinate Picker, PDF Brochure, Image Uploads, SEO Meta Tags -->
        <div class="col-lg-4">
            <!-- Map Coordinate Picker -->
            <div class="glass-card p-4 mb-4">
                <h5 class="fw-bold mb-2">Map Coordinate Picker</h5>
                <p class="text-muted small mb-3">Click anywhere on the map to set coordinates automatically.</p>
                <div id="coordPickerMap" style="height: 220px; border-radius: 0.5rem;" class="mb-3"></div>
                <div class="row g-2">
                    <div class="col-6">
                        <label asp-for="Latitude" class="form-label small fw-semibold">Latitude *</label>
                        <input asp-for="Latitude" id="latInput" type="number" step="0.000001" class="form-control rounded-3" required />
                    </div>
                    <div class="col-6">
                        <label asp-for="Longitude" class="form-label small fw-semibold">Longitude *</label>
                        <input asp-for="Longitude" id="lngInput" type="number" step="0.000001" class="form-control rounded-3" required />
                    </div>
                </div>
            </div>



            <!-- Image Uploads -->
            <div class="glass-card p-4 mb-4">
                <h5 class="fw-bold mb-2">Property Gallery Photos</h5>
                <p class="text-muted small mb-3">Upload multiple photos for Swiper carousels.</p>
                <input asp-for="NewImages" type="file" multiple accept="image/*" class="form-control rounded-3" />
            </div>

            <!-- SEO Meta Tags -->
            <div class="glass-card p-4 mb-4">
                <h5 class="fw-bold mb-2">SEO Meta Data</h5>
                <div class="mb-3">
                    <label asp-for="SeoTitle" class="form-label small fw-semibold">SEO Title (max 65 chars)</label>
                    <input asp-for="SeoTitle" maxlength="65" class="form-control rounded-3" placeholder="Luxury Condos NYC" />
                </div>
                <div>
                    <label asp-for="SeoDescription" class="form-label small fw-semibold">SEO Description (max 160 chars)</label>
                    <textarea asp-for="SeoDescription" maxlength="160" rows="3" class="form-control rounded-3" placeholder="Summary for Google search snippets..."></textarea>
                </div>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn btn-primary btn-lg rounded-pill w-100 py-3 fw-bold shadow">
                <i class="bi bi-cloud-arrow-up-fill me-2"></i> Publish Landmark Property
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Auto Slug Generator
            const nameInput = document.getElementById('projectNameInput');
            const slugInput = document.getElementById('projectSlugInput');
            let manualSlugEdit = false;

            slugInput.addEventListener('input', () => { manualSlugEdit = true; });
            nameInput.addEventListener('input', () => {
                if (!manualSlugEdit) {
                    slugInput.value = nameInput.value
                        .toLowerCase()
                        .trim()
                        .replace(/[^\w\s-]/g, '')
                        .replace(/[\s_-]+/g, '-')
                        .replace(/^-+|-+$/g, '');
                }
            });

            // Quill.js Setup
            const quill = new Quill('#quillEditor', {
                theme: 'snow',
                placeholder: 'Compose rich architectural narrative, design specifics, and amenities...',
                modules: {
                    toolbar: [
                        [{ 'header': [1, 2, 3, false] }],
                        ['bold', 'italic', 'underline', 'strike'],
                        [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                        ['link', 'blockquote', 'code-block'],
                        ['clean']
                    ]
                }
            });

            const form = document.getElementById('projectForm');
            form.addEventListener('submit', () => {
                document.getElementById('hiddenDescription').value = quill.root.innerHTML;
            });

            // Feature Quick Add Chips
            document.querySelectorAll('.feature-tag-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    const featText = btn.textContent.replace('+', '').trim();
                    const input = document.getElementById('featuresInput');
                    if (input.value) {
                        input.value += `, ${featText}`;
                    } else {
                        input.value = featText;
                    }
                });
            });

            // Leaflet Coordinate Picker
            const initialLat = parseFloat(document.getElementById('latInput').value) || 40.7128;
            const initialLng = parseFloat(document.getElementById('lngInput').value) || -74.0060;

            const map = L.map('coordPickerMap').setView([initialLat, initialLng], 12);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            let marker = L.marker([initialLat, initialLng], { draggable: true }).addTo(map);

            function updateInputs(lat, lng) {
                document.getElementById('latInput').value = lat.toFixed(6);
                document.getElementById('lngInput').value = lng.toFixed(6);
            }

            map.on('click', (e) => {
                marker.setLatLng(e.latlng);
                updateInputs(e.latlng.lat, e.latlng.lng);
            });

            marker.on('dragend', (e) => {
                const pos = marker.getLatLng();
                updateInputs(pos.lat, pos.lng);
            });
        });
    </script>
}
