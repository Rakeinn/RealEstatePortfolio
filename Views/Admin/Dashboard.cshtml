@model RealEstatePortfolio.Models.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Executive Analytics Dashboard";
    Layout = "_AdminLayout";
}

<!-- KPI Cards Grid -->
<div class="row g-4 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="glass-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Total Projects</span>
                    <h3 class="fw-bold mb-0 mt-1">@Model.TotalProjects</h3>
                </div>
                <div class="p-3 rounded-circle bg-primary bg-opacity-10 text-primary fs-3">
                    <i class="bi bi-buildings"></i>
                </div>
            </div>
            <div class="mt-3 small text-muted">
                <span class="text-success fw-semibold"><i class="bi bi-arrow-up-right me-1"></i>Active Portfolio</span>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="glass-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Under Construction</span>
                    <h3 class="fw-bold mb-0 mt-1 text-info">@Model.OngoingProjects</h3>
                </div>
                <div class="p-3 rounded-circle bg-info bg-opacity-10 text-info fs-3">
                    <i class="bi bi-hammer"></i>
                </div>
            </div>
            <div class="mt-3 small text-muted">
                <span>Active developments</span>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="glass-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Total Inquiries</span>
                    <h3 class="fw-bold mb-0 mt-1 text-primary">@Model.TotalLeads</h3>
                </div>
                <div class="p-3 rounded-circle bg-primary bg-opacity-10 text-primary fs-3">
                    <i class="bi bi-envelope-paper"></i>
                </div>
            </div>
            <div class="mt-3 small text-muted">
                <span>Leads from contact forms</span>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="glass-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Unread Inquiries</span>
                    <h3 class="fw-bold mb-0 mt-1 text-warning">@Model.UnreadLeads</h3>
                </div>
                <div class="p-3 rounded-circle bg-warning bg-opacity-10 text-warning fs-3">
                    <i class="bi bi-bell-fill"></i>
                </div>
            </div>
            <div class="mt-3 small text-muted">
                <a asp-action="Leads" asp-route-filter="unread" class="text-warning text-decoration-none fw-semibold">Review unread leads &rarr;</a>
            </div>
        </div>
    </div>
</div>

<!-- Chart.js Analytics Overview -->
<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="glass-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h5 class="fw-bold mb-1">Monthly Lead Volume Influx</h5>
                    <small class="text-muted">Inbound inquiries across the last 6 months</small>
                </div>
                <a asp-action="Leads" class="btn btn-outline-primary btn-sm rounded-pill px-3">View Full Inbox</a>
            </div>
            <div style="height: 280px;">
                <canvas id="leadsChart"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="glass-card p-4 h-100">
            <div class="mb-4">
                <h5 class="fw-bold mb-1">Portfolio Status Distribution</h5>
                <small class="text-muted">Active project breakdown</small>
            </div>
            <div style="height: 280px; position: relative;">
                <canvas id="statusChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Recent Inquiries & Projects Data Tables -->
<div class="row g-4">
    <div class="col-lg-7">
        <div class="glass-card p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">Recent VIP Inquiries</h5>
                <a asp-action="Leads" class="small text-primary text-decoration-none">View All (@Model.TotalLeads)</a>
            </div>
            <div class="table-responsive">
                <table class="table align-middle table-hover mb-0">
                    <thead>
                        <tr class="text-muted small text-uppercase">
                            <th>Client</th>
                            <th>Subject</th>
                            <th>Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var lead in Model.RecentLeads)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold">@lead.ClientName</div>
                                    <small class="text-muted">@lead.EmailAddress</small>
                                </td>
                                <td>
                                    <span class="d-inline-block text-truncate" style="max-width: 180px;">@lead.Subject</span>
                                </td>
                                <td class="small text-muted">@lead.SubmittedAt.ToString("MMM dd, yyyy")</td>
                                <td>
                                    @if (!lead.IsRead)
                                    {
                                        <span class="badge bg-warning text-dark">Unread</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-25 text-body">Read</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="glass-card p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">Portfolio Highlights</h5>
                <a asp-action="CreateProject" class="btn btn-primary btn-sm rounded-pill px-3"><i class="bi bi-plus me-1"></i>New Project</a>
            </div>
            <div class="d-flex flex-column gap-3">
                @foreach (var p in Model.RecentProjects)
                {
                    <div class="d-flex align-items-center gap-3 p-2 rounded-3 bg-body border">
                        <img src="@(p.PrimaryImage?.ImagePath ?? "/images/properties/lumina-1.svg")" alt="@p.Name" class="rounded-2" style="width: 54px; height: 54px; object-fit: cover;" />
                        <div class="flex-grow-1 overflow-hidden">
                            <h6 class="fw-bold mb-0 text-truncate">@p.Name</h6>
                            <small class="text-muted">@p.Status • @(p.CompletionYear.HasValue ? p.CompletionYear.ToString() : "Ongoing")</small>
                        </div>
                        <a asp-action="EditProject" asp-route-id="@p.Id" class="btn btn-outline-secondary btn-sm rounded-circle p-2">
                            <i class="bi bi-pencil-fill"></i>
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Chart.js Lead Volume
            const leadCtx = document.getElementById('leadsChart').getContext('2d');
            new Chart(leadCtx, {
                type: 'line',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadMonths)),
                    datasets: [{
                        label: 'Inquiries Received',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadCounts)),
                        borderColor: '#0284c7',
                        backgroundColor: 'rgba(2, 132, 199, 0.15)',
                        borderWidth: 3,
                        fill: true,
                        tension: 0.35,
                        pointBackgroundColor: '#0284c7',
                        pointRadius: 5
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, grid: { color: 'rgba(255,255,255,0.05)' } },
                        x: { grid: { display: false } }
                    }
                }
            });

            // Chart.js Status Doughnut
            const statusCtx = document.getElementById('statusChart').getContext('2d');
            new Chart(statusCtx, {
                type: 'doughnut',
                data: {
                    labels: ['Upcoming', 'Ongoing', 'Completed'],
                    datasets: [{
                        data: [@Model.UpcomingProjects, @Model.OngoingProjects, @Model.CompletedProjects],
                        backgroundColor: ['#f59e0b', '#0284c7', '#10b981'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' }
                    }
                }
            });
        });
    </script>
}
