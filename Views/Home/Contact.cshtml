@model RealEstatePortfolio.Models.ViewModels.ContactFormViewModel

@{
    ViewData["Title"] = "Contact Recent Group | Recent Properties, Living & Interior";
    var cms = ViewBag.ContactContent as Dictionary<string, string> ?? new Dictionary<string, string>();
    var address = cms.GetValueOrDefault("Office_Address", "Recent Group Corporate Tower, Level 24, 742 Fifth Avenue, New York, NY 10019");
    var phone = cms.GetValueOrDefault("Office_Phone", "+1 (212) 555-0198");
    var email = cms.GetValueOrDefault("Office_Email", "info@recentgroup.com");
    var hours = cms.GetValueOrDefault("Operating_Hours", "Monday - Friday: 08:30 AM - 06:30 PM EST");
}

<section class="py-5 bg-body-tertiary border-bottom">
    <div class="container py-lg-4 text-center">
        <span class="badge-editorial mb-3" data-aos="fade-down">Advisory & Inquiries</span>
        <h1 class="display-4 fw-bold mb-3 font-serif" data-aos="fade-up">Contact Recent Group</h1>
        <p class="lead text-muted max-w-700 mx-auto" data-aos="fade-up" data-aos-delay="100">
            Connect with Recent Group corporate headquarters or direct your inquiry to our specialized sister concerns: Recent Properties Ltd, Recent Living Ltd, or Recent Living Interior.
        </p>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row g-5">
            <!-- Contact Info -->
            <div class="col-lg-5" data-aos="fade-right">
                <div class="glass-card p-4 p-lg-5 h-100 d-flex flex-column justify-content-between">
                    <div>
                        <span class="badge-editorial mb-3">Global Headquarters</span>
                        <h3 class="fw-bold mb-4 font-serif">Recent Group Tower</h3>

                        <div class="d-flex flex-column gap-4 text-muted">
                            <div class="d-flex gap-3">
                                <div class="p-3 rounded-circle bg-primary bg-opacity-10 text-primary fs-5">
                                    <i class="bi bi-geo-alt-fill"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold text-body mb-1">Corporate Address</h6>
                                    <p class="mb-0 small">@address</p>
                                </div>
                            </div>

                            <div class="d-flex gap-3">
                                <div class="p-3 rounded-circle bg-primary bg-opacity-10 text-primary fs-5">
                                    <i class="bi bi-telephone-fill"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold text-body mb-1">Telephone Enquiries</h6>
                                    <p class="mb-0 small">@phone</p>
                                </div>
                            </div>

                            <div class="d-flex gap-3">
                                <div class="p-3 rounded-circle bg-primary bg-opacity-10 text-primary fs-5">
                                    <i class="bi bi-envelope-fill"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold text-body mb-1">General Email</h6>
                                    <p class="mb-0 small">@email</p>
                                </div>
                            </div>

                            <div class="d-flex gap-3">
                                <div class="p-3 rounded-circle bg-primary bg-opacity-10 text-primary fs-5">
                                    <i class="bi bi-clock-fill"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold text-body mb-1">Business Hours</h6>
                                    <p class="mb-0 small">@hours</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Sister Concerns Desks -->
                    <div class="mt-4 pt-4 border-top">
                        <small class="text-muted d-block mb-3 font-semibold text-uppercase tracking-wider">Dedicated Subsidiary Desks:</small>
                        <div class="d-flex flex-column gap-2 small">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-semibold text-primary"><i class="bi bi-building me-1"></i> Recent Properties Ltd</span>
                                <span class="text-muted">properties@recentgroup.com</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-semibold text-success"><i class="bi bi-houses me-1"></i> Recent Living Ltd</span>
                                <span class="text-muted">living@recentgroup.com</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-semibold text-warning"><i class="bi bi-palette me-1"></i> Recent Living Interior</span>
                                <span class="text-muted">interiors@recentgroup.com</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Contact Form -->
            <div class="col-lg-7" data-aos="fade-left">
                <div class="glass-card p-4 p-lg-5">
                    <h3 class="fw-bold mb-2 font-serif">Send an Inquiry</h3>
                    <p class="text-muted mb-4 small">Select the relevant sister concern or submit to Recent Group corporate.</p>

                    <form asp-action="Contact" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="PreferredProjectSlug" />

                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="TargetedConcern" class="form-label small fw-semibold">Target Concern / Subsidiary</label>
                                <select asp-for="TargetedConcern" class="form-select rounded-3 py-2">
                                    <option value="Recent Group Corporate">Recent Group Corporate (General Inquiries)</option>
                                    <option value="Recent Properties Ltd">Recent Properties Ltd (Land & Commercial High-Rises)</option>
                                    <option value="Recent Living Ltd">Recent Living Ltd (Residential Condominiums & Eco-Sanctuaries)</option>
                                    <option value="Recent Living Interior">Recent Living Interior (Bespoke Interior Design & Turnkey Fit-Outs)</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ClientName" class="form-label small fw-semibold">Full Name *</label>
                                <input asp-for="ClientName" class="form-control rounded-3 py-2" placeholder="e.g. Eleanor Vance" />
                                <span asp-validation-for="ClientName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="EmailAddress" class="form-label small fw-semibold">Email Address *</label>
                                <input asp-for="EmailAddress" class="form-control rounded-3 py-2" placeholder="eleanor@domain.com" />
                                <span asp-validation-for="EmailAddress" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="form-label small fw-semibold">Phone Number</label>
                                <input asp-for="PhoneNumber" class="form-control rounded-3 py-2" placeholder="+1 (555) 012-3456" />
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Subject" class="form-label small fw-semibold">Subject *</label>
                                <input asp-for="Subject" class="form-control rounded-3 py-2" placeholder="Property Inquiry / Viewing Request" />
                                <span asp-validation-for="Subject" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Message" class="form-label small fw-semibold">Message *</label>
                                <textarea asp-for="Message" rows="5" class="form-control rounded-3" placeholder="Please describe your requirements, specifications, or preferred meeting schedule..."></textarea>
                                <span asp-validation-for="Message" class="text-danger small"></span>
                            </div>

                            <div class="col-12 mt-4">
                                <button type="submit" class="btn btn-primary rounded-pill px-5 py-3 w-100 fw-bold shadow-sm">
                                    <i class="bi bi-send-fill me-2"></i>Dispatch Inquiry to Recent Group
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Office Map -->
        <div class="mt-5 glass-card p-2" data-aos="zoom-in">
            <div id="officeMap" class="map-container rounded-4"></div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const map = L.map('officeMap').setView([40.7638, -73.9730], 14);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            const marker = L.marker([40.7638, -73.9730]).addTo(map);
            marker.bindPopup('<b>Recent Group Corporate Tower</b><br>Level 24, 742 Fifth Avenue, New York, NY').openPopup();
        });
    </script>
}
