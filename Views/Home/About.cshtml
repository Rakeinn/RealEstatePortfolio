@{
    ViewData["Title"] = "About Us | Recent Group & Recent Living Ltd.";
}

<section class="py-5 bg-body-tertiary border-bottom">
    <div class="container py-lg-4 text-center">
        <span class="badge-editorial mb-3" data-aos="fade-down">Corporate Profile</span>
        <h1 class="display-4 fw-bold mb-3 font-serif" data-aos="fade-up">Recent Group & Recent Living Ltd.</h1>
        <p class="lead text-muted max-w-700 mx-auto" data-aos="fade-up" data-aos-delay="100">
            A trusted and respected real estate conglomerate creating thoughtfully designed homes and commercial spaces that enrich people's lives and contribute to better communities in Bangladesh and beyond.
        </p>
    </div>
</section>

<!-- Vision & Mission of Recent Living Ltd. -->
<section class="py-5">
    <div class="container py-lg-4">
        <div class="row g-5 align-items-center mb-5">
            <div class="col-lg-6" data-aos="fade-right">
                <div class="glass-card p-4 p-lg-5 text-center shadow-lg">
                    <img src="/images/logo.png" alt="Recent Group Logo" class="img-fluid mb-3" style="max-height: 250px; object-fit: contain;" />
                    <h4 class="fw-bold font-serif mb-1">Recent Living Ltd.</h4>
                    <p class="text-success fw-bold fs-5 fst-italic mb-0">Better Lifestyle…</p>
                </div>
            </div>

            <div class="col-lg-6" data-aos="fade-left">
                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1 fw-bold small mb-3">Our Core Philosophy</span>
                <h2 class="display-6 fw-bold font-serif mb-3">Recent Living Ltd.</h2>
                <h4 class="text-success fst-italic font-serif mb-4">Better Lifestyle…</h4>

                <div class="p-4 rounded-3 glass-card mb-4 border-start border-4 border-success">
                    <h5 class="fw-bold text-success font-serif mb-2"><i class="bi bi-eye-fill me-2"></i>Our Vision</h5>
                    <blockquote class="blockquote fs-6 text-muted mb-2">
                        "To become a trusted and respected real estate company in Bangladesh, creating thoughtfully designed homes and commercial spaces that enrich people's lives and contribute to better communities."
                    </blockquote>
                    <p class="small text-muted mb-0">
                        We envision a future where every project we develop reflects quality, trust, thoughtful design, and lasting value—creating places where people can truly enjoy a better lifestyle.
                    </p>
                </div>

                <div class="p-4 rounded-3 glass-card border-start border-4 border-primary">
                    <h5 class="fw-bold text-primary font-serif mb-2"><i class="bi bi-compass-fill me-2"></i>Our Mission</h5>
                    <blockquote class="blockquote fs-6 text-muted mb-2">
                        "To develop quality residential and commercial projects through trusted partnerships, responsible development, innovative design, and customer-focused service—creating lasting value for landowners, investors, customers, and communities."
                    </blockquote>
                    <p class="small text-muted mb-0">
                        At Recent Living Ltd., we bring together landowners, investors, professionals, architects, engineers, and customers to transform opportunities into successful real estate projects.
                    </p>
                </div>
            </div>
        </div>

        <!-- 7 Core Commitments -->
        <div class="mt-5 pt-4 border-top" data-aos="fade-up">
            <div class="text-center max-w-700 mx-auto mb-5">
                <span class="badge-editorial mb-2">Commitments</span>
                <h3 class="display-6 fw-bold font-serif">What We Are Committed To</h3>
                <p class="text-muted">Guiding values that shape our partnerships with landowners, investors, and homeowners.</p>
            </div>

            <div class="row g-4">
                <div class="col-md-6 col-lg-4">
                    <div class="glass-card h-100 p-4 d-flex align-items-start gap-3">
                        <i class="bi bi-check-circle-fill text-success fs-3 mt-1"></i>
                        <div>
                            <h6 class="fw-bold mb-1">Quality Projects</h6>
                            <p class="text-muted small mb-0">Developing quality residential apartments and commercial projects.</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="glass-card h-100 p-4 d-flex align-items-start gap-3">
                        <i class="bi bi-check-circle-fill text-success fs-3 mt-1"></i>
                        <div>
                            <h6 class="fw-bold mb-1">Joint Venture Partnerships</h6>
                            <p class="text-muted small mb-0">Building strong and transparent Joint Venture partnerships with landowners.</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="glass-card h-100 p-4 d-flex align-items-start gap-3">
                        <i class="bi bi-check-circle-fill text-success fs-3 mt-1"></i>
                        <div>
                            <h6 class="fw-bold mb-1">Modern Living Spaces</h6>
                            <p class="text-muted small mb-0">Creating practical, attractive, and modern living spaces designed for comfort.</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="glass-card h-100 p-4 d-flex align-items-start gap-3">
                        <i class="bi bi-check-circle-fill text-success fs-3 mt-1"></i>
                        <div>
                            <h6 class="fw-bold mb-1">Reliable Turnkey Solutions</h6>
                            <p class="text-muted small mb-0">Delivering reliable interior and exterior solutions with Recent Living Interior.</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="glass-card h-100 p-4 d-flex align-items-start gap-3">
                        <i class="bi bi-check-circle-fill text-success fs-3 mt-1"></i>
                        <div>
                            <h6 class="fw-bold mb-1">Quality & Workmanship</h6>
                            <p class="text-muted small mb-0">Maintaining high standards of quality, civil safety, and workmanship.</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="glass-card h-100 p-4 d-flex align-items-start gap-3">
                        <i class="bi bi-check-circle-fill text-success fs-3 mt-1"></i>
                        <div>
                            <h6 class="fw-bold mb-1">Long-Term Value</h6>
                            <p class="text-muted small mb-0">Creating long-term value for our customers, investors, and community partners.</p>
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="glass-card p-4 text-center border-success bg-success bg-opacity-10">
                        <h5 class="fw-bold mb-1 text-success"><i class="bi bi-shield-check me-2"></i>Trust, Integrity & Professionalism</h5>
                        <p class="text-muted small mb-0">Building lasting relationships with landowners, clients, and professionals based on transparent ethics.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Sister Concerns Matrix -->
<section class="py-5 bg-body-tertiary border-top">
    <div class="container py-lg-4">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="badge-editorial mb-2">Corporate Group</span>
            <h2 class="display-5 fw-bold font-serif">Recent Group Sister Concerns</h2>
            <p class="text-muted">A comprehensive triad providing complete real estate development lifecycle execution.</p>
        </div>

        <div class="row g-4">
            <div class="col-md-4" data-aos="fade-up" data-aos-delay="100">
                <div class="glass-card p-4 h-100 d-flex flex-column">
                    <span class="text-primary fw-bold small text-uppercase mb-2"><i class="bi bi-building me-1"></i> Development Arm</span>
                    <h4 class="fw-bold font-serif mb-2">Recent Properties Ltd</h4>
                    <p class="text-muted small mb-0 lh-lg flex-grow-1">
                        Land acquisitions, monumental civil construction, and commercial towers engineered to international safety standards.
                    </p>
                </div>
            </div>

            <div class="col-md-4" data-aos="fade-up" data-aos-delay="200">
                <div class="glass-card p-4 h-100 d-flex flex-column border-success">
                    <span class="text-success fw-bold small text-uppercase mb-2"><i class="bi bi-houses me-1"></i> Residential Arm</span>
                    <h4 class="fw-bold font-serif mb-1">Recent Living Ltd.</h4>
                    <small class="text-success fw-bold mb-3">Better Lifestyle…</small>
                    <p class="text-muted small mb-0 lh-lg flex-grow-1">
                        Developing quality residential apartments, eco-condominiums, and transparent Joint Venture partnerships for landowners.
                    </p>
                </div>
            </div>

            <div class="col-md-4" data-aos="fade-up" data-aos-delay="300">
                <div class="glass-card p-4 h-100 d-flex flex-column">
                    <span class="text-warning fw-bold small text-uppercase mb-2"><i class="bi bi-palette me-1"></i> Interior Arm</span>
                    <h4 class="fw-bold font-serif mb-2">Recent Living Interior</h4>
                    <p class="text-muted small mb-0 lh-lg flex-grow-1">
                        Turnkey interior architecture, artisanal wood joinery, custom furniture, and spatial design for homes and offices.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
