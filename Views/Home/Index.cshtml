                        <h5 class="text-white fw-bold font-serif mb-1 text-shadow-sm">Recent Jahanara Garden</h5>
                        <p class="text-white text-opacity-80 small mb-0">Modern residential apartments with open balconies.</p>
                    </div>
                    <div class="gallery-tile-zoom-icon">
                        <i class="bi bi-arrows-fullscreen"></i>
                    </div>
                </div>
            </div>

            <div class="col-md-4" data-aos="fade-up" data-aos-duration="750" data-aos-delay="350">
                <div class="gallery-tile gallery-tile-sm position-relative overflow-hidden rounded-4 shadow-sm" data-img="/images/properties/0707b73aa4b64accb4aa17cf5380639f.jpg" data-title="Takowa Recent Park" data-category="Recent Living Ltd.">
                    <img src="/images/properties/0707b73aa4b64accb4aa17cf5380639f.jpg" alt="Takowa Recent Park" class="gallery-tile-img w-100 h-100" loading="lazy" />
                    <div class="gallery-tile-overlay"></div>
                    <div class="gallery-tile-content">
                        <span class="badge bg-primary bg-opacity-90 text-white rounded-pill px-3 py-1 small mb-2">Recent Living Ltd.</span>
                        <h5 class="text-white fw-bold font-serif mb-1 text-shadow-sm">Takowa Recent Park</h5>
                        <p class="text-white text-opacity-80 small mb-0">Thoughtfully crafted urban sanctuary in Dakshinkhan.</p>
                    </div>
                    <div class="gallery-tile-zoom-icon">
                        <i class="bi bi-arrows-fullscreen"></i>
                    </div>
                </div>
