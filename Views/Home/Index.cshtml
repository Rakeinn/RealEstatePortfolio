</section>

<!-- Lightbox Modal for Gallery Grid -->
<div class="modal fade" id="galleryLightboxModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content bg-dark border-secondary border-opacity-25 rounded-4 overflow-hidden">
            <div class="modal-header border-0 pb-0 position-absolute top-0 end-0 z-3 p-3">
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0 text-center position-relative" style="background-color: #050811;">
                <img id="lightboxModalImg" src="" alt="Gallery Image" class="img-fluid" style="max-height: 80vh; width: 100%; object-fit: contain;" />
                <div class="p-3 text-start bg-black bg-opacity-75 backdrop-blur border-top border-secondary border-opacity-25 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                    <div>
                        <span id="lightboxModalCategory" class="badge bg-primary rounded-pill px-3 py-1 small mb-1"></span>
                        <h5 id="lightboxModalTitle" class="text-white fw-bold font-serif mb-0"></h5>
                    </div>
                    <button type="button" class="btn btn-outline-light btn-sm rounded-pill px-3" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Joint Venture Section for Landowners -->
<section id="joint-venture" class="py-5">
    <div class="container py-lg-4">
        <div class="glass-card p-4 p-lg-5 shadow-lg" data-aos="zoom-in">
            <div class="row g-5 align-items-center">
                <div class="col-lg-5">
                    <span class="badge-editorial d-inline-block mb-3">Joint Venture Opportunity</span>
                    <h2 class="display-6 fw-bold mb-3 font-serif">Landowner Partnerships</h2>
                    <p class="text-muted mb-4 lh-lg">
                        At <strong>Recent Living Ltd.</strong>, we bring together landowners, investors, professionals, architects, and engineers to transform prime plots into successful real estate landmarks.
                    </p>
                    <div class="d-flex flex-column gap-3 text-muted small">
                        <div class="d-flex align-items-center gap-3">
                            <span class="p-2 rounded-circle bg-success bg-opacity-10 text-success"><i class="bi bi-shield-check"></i></span>
                            <span>Transparent and ethical Joint Venture agreements.</span>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <span class="p-2 rounded-circle bg-success bg-opacity-10 text-success"><i class="bi bi-clock-history"></i></span>
                            <span>On-time project delivery with highest construction standards.</span>
                        </div>
                    </div>
                </div>

                <div class="col-lg-7">
                    <form class="ajax-inquiry-form">
                        <input type="hidden" name="PreferredProjectSlug" value="joint-venture-inquiry" />
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Target Concern / Subsidiary</label>
                                <select name="TargetedConcern" class="form-select rounded-3 py-2">
                                    <option value="Recent Living Ltd" selected>Recent Living Ltd. (Residential & Joint Ventures)</option>
                                    <option value="Recent Properties Ltd">Recent Properties Ltd (Commercial & Land)</option>
                                    <option value="Recent Living Interior">Recent Living Interior (Interior Design)</option>
                                    <option value="Recent Group Corporate">Recent Group Corporate</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Full Name *</label>
                                <input type="text" name="ClientName" class="form-control rounded-3 py-2" placeholder="e.g. Engr. Rafiqul Islam" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Email Address *</label>
                                <input type="email" name="EmailAddress" class="form-control rounded-3 py-2" placeholder="rafiqul@domain.com" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Phone Number *</label>
                                <input type="tel" name="PhoneNumber" class="form-control rounded-3 py-2" placeholder="+880 1711 000000" required />
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Subject *</label>
                                <input type="text" name="Subject" class="form-control rounded-3 py-2" placeholder="Joint Venture / Apartment Inquiry" required />
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Message / Land Details *</label>
                                <textarea name="Message" class="form-control rounded-3" rows="4" placeholder="Specify land location, size in katha, road width, or apartment inquiry details..." required></textarea>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-success rounded-pill px-5 py-3 w-100 fw-bold">
                                    <i class="bi bi-send-fill me-2"></i>Submit Inquiry to Recent Living Ltd.
                                </button>
                                <div class="inquiry-alert-box d-none"></div>
                            </div>
                        </div>
