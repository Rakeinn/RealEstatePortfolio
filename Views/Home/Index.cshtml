                    <div class="gallery-tile-overlay"></div>
                    <div class="gallery-tile-content">
                        <span class="badge bg-primary bg-opacity-90 text-white rounded-pill px-3 py-1 small mb-2">Signature Architecture</span>
                        <h4 class="text-white fw-bold font-serif mb-1 text-shadow-sm">Grand Residential Arrival Court</h4>
                        <p class="text-white text-opacity-80 small mb-0 d-none d-sm-block">Signature landscaped entrance with warm ambient evening illumination.</p>
                    </div>
                    <div class="gallery-tile-zoom-icon">
                        <i class="bi bi-arrows-fullscreen"></i>
                    </div>
                </div>
            </div>

            <!-- Row 1 Right: Two Stacked Tiles (228px + 24px gap + 228px = 480px exact match) -->
            <div class="col-lg-4">
                <div class="row g-4">
                    <div class="col-md-6 col-lg-12" data-aos="fade-up" data-aos-duration="750" data-aos-delay="100">
                        <div class="gallery-tile gallery-tile-sm position-relative overflow-hidden rounded-4 shadow-sm" data-img="/images/hero/slide-2.jpg" data-title="Cascading Balconies & Sky Gardens" data-category="Eco-Architecture">
                            <img src="/images/hero/slide-2.jpg" alt="Cascading Balconies & Sky Gardens" class="gallery-tile-img w-100 h-100" loading="lazy" />
                            <div class="gallery-tile-overlay"></div>
                            <div class="gallery-tile-content">
                                <span class="badge bg-success bg-opacity-90 text-white rounded-pill px-3 py-1 small mb-2">Eco-Architecture</span>
                                <h5 class="text-white fw-bold font-serif mb-1 text-shadow-sm">Sky Gardens &amp; Balconies</h5>
                                <p class="text-white text-opacity-80 small mb-0">Biophilic facade integration with natural sunlight.</p>
                            </div>
                            <div class="gallery-tile-zoom-icon">
                                <i class="bi bi-arrows-fullscreen"></i>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6 col-lg-12" data-aos="fade-up" data-aos-duration="750" data-aos-delay="200">
                        <div class="gallery-tile gallery-tile-sm position-relative overflow-hidden rounded-4 shadow-sm" data-img="/images/hero/slide-3.jpg" data-title="Sunlit Panoramic Duplex Living" data-category="Living Interior">
                            <img src="/images/hero/slide-3.jpg" alt="Sunlit Panoramic Duplex Living" class="gallery-tile-img w-100 h-100" loading="lazy" />
                            <div class="gallery-tile-overlay"></div>
                            <div class="gallery-tile-content">
                                <span class="badge bg-warning text-dark rounded-pill px-3 py-1 small mb-2 fw-semibold">Living Interior</span>
                                <h5 class="text-white fw-bold font-serif mb-1 text-shadow-sm">Sunlit Duplex Living</h5>
                                <p class="text-white text-opacity-80 small mb-0">High-ceiling panoramic residences by Recent Living Interior.</p>
                            </div>
                            <div class="gallery-tile-zoom-icon">
                                <i class="bi bi-arrows-fullscreen"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Row 2: Three Equal Architectural Tiles -->
            <div class="col-md-4" data-aos="fade-up" data-aos-duration="750" data-aos-delay="150">
                <div class="gallery-tile gallery-tile-sm position-relative overflow-hidden rounded-4 shadow-sm" data-img="/images/properties/recent-renu-garden.jpg" data-title="Recent Renu Garden" data-category="Commercial + Residential">
                    <img src="/images/properties/recent-renu-garden.jpg" alt="Recent Renu Garden" class="gallery-tile-img w-100 h-100" style="object-position: center 20%;" loading="lazy" />
                    <div class="gallery-tile-overlay"></div>
                    <div class="gallery-tile-content">
                        <span class="badge bg-primary bg-opacity-90 text-white rounded-pill px-3 py-1 small mb-2">Recent Living Ltd.</span>
                        <h5 class="text-white fw-bold font-serif mb-1 text-shadow-sm">Recent Renu Garden</h5>
                        <p class="text-white text-opacity-80 small mb-0">8-Katha East-Facing B+G+08 Floors in Uttara, Dhaka.</p>
                    </div>
                    <div class="gallery-tile-zoom-icon">
                        <i class="bi bi-arrows-fullscreen"></i>
                    </div>
                </div>
            </div>

            <div class="col-md-4" data-aos="fade-up" data-aos-duration="750" data-aos-delay="250">
                <div class="gallery-tile gallery-tile-sm position-relative overflow-hidden rounded-4 shadow-sm" data-img="/images/properties/ee4dd91d78dc463ebbf64690d524b4a7.jpg" data-title="Recent Jahanara Garden" data-category="Recent Properties Ltd">
                    <img src="/images/properties/ee4dd91d78dc463ebbf64690d524b4a7.jpg" alt="Recent Jahanara Garden" class="gallery-tile-img w-100 h-100" loading="lazy" />
