@model List<RealEstatePortfolio.Models.Entities.Building>

@{
    ViewData["Title"] = "Recent Living Ltd. | Better Lifestyle… - Bangladesh";
}

<!-- Hero Brand Banner -->
<section class="py-5 bg-body-tertiary border-bottom position-relative overflow-hidden">
    <div class="container py-lg-5">
        <div class="row align-items-center g-5">
            <div class="col-lg-7" data-aos="fade-right">
                <div class="d-inline-flex align-items-center gap-2 mb-3 px-3 py-1 rounded-pill bg-success bg-opacity-10 text-success border border-success border-opacity-25 small fw-bold">
                    <i class="bi bi-patch-check-fill"></i> A Sister Concern of Recent Group
                </div>
                <h1 class="display-3 fw-bold font-serif mb-2 text-body">
                    Recent Living Ltd.
                </h1>
                <p class="display-6 text-success fst-italic font-serif mb-4" style="letter-spacing: -0.01em;">
                    Better Lifestyle…
                </p>
                <p class="lead text-muted mb-5 lh-lg">
                    Creating thoughtfully designed homes and commercial spaces across Bangladesh that enrich people's lives and contribute to thriving communities through quality, trust, and lasting value.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a href="#vision-mission" class="btn btn-success btn-lg rounded-pill px-4 py-3 shadow-sm d-flex align-items-center gap-2">
                        <span>Our Vision & Mission</span>
                        <i class="bi bi-arrow-down"></i>
                    </a>
                    <a href="#joint-venture" class="btn btn-outline-success btn-lg rounded-pill px-4 py-3">
                        <i class="bi bi-handshake me-2"></i>Joint Venture Proposal
                    </a>
                </div>
            </div>

            <div class="col-lg-5 text-center" data-aos="zoom-in">
                <div class="glass-card p-4 p-lg-5 shadow-lg position-relative">
                    <img src="/images/logo.png" asp-append-version="true" alt="Recent Group Logo" class="img-fluid mb-3 brand-logo-img" style="max-height: 220px; object-fit: contain;" />
                    <div class="border-top pt-3 mt-3">
                        <h5 class="fw-bold font-serif mb-1">Recent Living Ltd.</h5>
                        <small class="text-success fw-bold text-uppercase tracking-wider">Better Lifestyle…</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Vision & Mission Section -->
<section id="vision-mission" class="py-5">
    <div class="container py-lg-4">
        <div class="row g-4">
            <!-- Our Vision -->
            <div class="col-lg-6" data-aos="fade-up" data-aos-delay="100">
                <div class="glass-card h-100 p-4 p-lg-5 border-start border-4 border-success d-flex flex-column">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <span class="p-3 rounded-circle bg-success bg-opacity-10 text-success fs-3">
                            <i class="bi bi-eye-fill"></i>
                        </span>
                        <div>
                            <span class="text-success small text-uppercase tracking-wider fw-bold">Our Aspirations</span>
                            <h3 class="fw-bold font-serif mb-0">Our Vision</h3>
                        </div>
                    </div>
                    
                    <blockquote class="blockquote fs-5 fst-italic text-body my-4 p-4 rounded-3 bg-body border-start border-3 border-success">
                        "To become a trusted and respected real estate company in Bangladesh, creating thoughtfully designed homes and commercial spaces that enrich people's lives and contribute to better communities."
                    </blockquote>

                    <p class="text-muted lh-lg mt-auto mb-0">
                        We envision a future where every project we develop reflects quality, trust, thoughtful design, and lasting value—creating places where people can truly enjoy a better lifestyle.
                    </p>
                </div>
            </div>

            <!-- Our Mission -->
            <div class="col-lg-6" data-aos="fade-up" data-aos-delay="200">
                <div class="glass-card h-100 p-4 p-lg-5 border-start border-4 border-primary d-flex flex-column">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <span class="p-3 rounded-circle bg-primary bg-opacity-10 text-primary fs-3">
                            <i class="bi bi-compass-fill"></i>
                        </span>
                        <div>
                            <span class="text-primary small text-uppercase tracking-wider fw-bold">Our Purpose</span>
                            <h3 class="fw-bold font-serif mb-0">Our Mission</h3>
                        </div>
                    </div>

                    <blockquote class="blockquote fs-5 fst-italic text-body my-4 p-4 rounded-3 bg-body border-start border-3 border-primary">
                        "To develop quality residential and commercial projects through trusted partnerships, responsible development, innovative design, and customer-focused service—creating lasting value for landowners, investors, customers, and communities."
                    </blockquote>

                    <p class="text-muted lh-lg mt-auto mb-0">
                        At Recent Living Ltd., we bring together landowners, investors, professionals, architects, engineers, and customers to transform opportunities into successful real estate projects.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Core Commitments (The 7 Pillars) -->
<section class="py-5 bg-body-tertiary border-top border-bottom">
    <div class="container py-lg-4">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="badge-editorial mb-2">Core Pillars</span>
            <h2 class="display-5 fw-bold font-serif">We Are Committed To:</h2>
            <p class="text-muted max-w-700 mx-auto">
                Guiding principles that define every project, joint venture partnership, and customer relationship at Recent Living Ltd.
            </p>
        </div>

        <div class="row g-4">
            <!-- Commitment 1 -->
            <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="100">
                <div class="glass-card h-100 p-4 d-flex align-items-start gap-3">
                    <div class="p-3 rounded-3 bg-success bg-opacity-10 text-success fs-4">
                        <i class="bi bi-building-check"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-2">Quality Residential & Commercial Projects</h6>
                        <p class="text-muted small mb-0 lh-base">
                            Developing quality residential apartments and commercial projects engineered with modern structural standards.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Commitment 2 -->
            <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="150">
                <div class="glass-card h-100 p-4 d-flex align-items-start gap-3">
                    <div class="p-3 rounded-3 bg-primary bg-opacity-10 text-primary fs-4">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-2">Transparent Joint Venture Partnerships</h6>
                        <p class="text-muted small mb-0 lh-base">
                            Building strong, ethical, and completely transparent partnerships with landowners and financial stakeholders.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Commitment 3 -->
            <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="200">
                <div class="glass-card h-100 p-4 d-flex align-items-start gap-3">
                    <div class="p-3 rounded-3 bg-warning bg-opacity-10 text-warning fs-4">
                        <i class="bi bi-house-heart-fill"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-2">Practical, Attractive & Modern Spaces</h6>
                        <p class="text-muted small mb-0 lh-base">
                            Creating functional, aesthetically inspiring, and contemporary living environments optimized for comfort.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Commitment 4 -->
            <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="250">
                <div class="glass-card h-100 p-4 d-flex align-items-start gap-3">
                    <div class="p-3 rounded-3 bg-info bg-opacity-10 text-info fs-4">
                        <i class="bi bi-palette-fill"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-2">Reliable Interior & Exterior Solutions</h6>
                        <p class="text-muted small mb-0 lh-base">
                            Delivering end-to-end architectural facades and turnkey interior fit-outs in collaboration with Recent Living Interior.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Commitment 5 -->
            <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="300">
                <div class="glass-card h-100 p-4 d-flex align-items-start gap-3">
                    <div class="p-3 rounded-3 bg-danger bg-opacity-10 text-danger fs-4">
                        <i class="bi bi-award-fill"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-2">High Standards of Workmanship</h6>
                        <p class="text-muted small mb-0 lh-base">
                            Maintaining rigorous quality control, certified construction materials, and experienced civil engineers.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Commitment 6 -->
            <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="350">
                <div class="glass-card h-100 p-4 d-flex align-items-start gap-3">
                    <div class="p-3 rounded-3 bg-success bg-opacity-10 text-success fs-4">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-2">Long-Term Value Creation</h6>
                        <p class="text-muted small mb-0 lh-base">
                            Generating sustainable appreciation and lasting investment returns for customers, homeowners, and partners.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Commitment 7 -->
            <div class="col-12" data-aos="fade-up" data-aos-delay="400">
                <div class="glass-card p-4 p-lg-5 text-center border-success">
                    <div class="d-inline-flex p-3 rounded-circle bg-success bg-opacity-10 text-success fs-2 mb-3">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>
                    <h4 class="fw-bold font-serif mb-2">Building Relationships Based on Trust, Integrity & Professionalism</h4>
                    <p class="text-muted max-w-700 mx-auto mb-0 lh-lg">
                        At Recent Living Ltd., our reputation is built on transparent communication, timely handovers, and lifelong customer satisfaction.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Current Recent Living Ltd Projects -->
<section class="py-5">
    <div class="container py-lg-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-5" data-aos="fade-up">
            <div>
                <span class="badge-editorial mb-2">Residential & Commercial</span>
                <h2 class="display-5 fw-bold font-serif">Recent Living Ltd. Projects</h2>
                <p class="text-muted mb-0">Thoughtfully designed homes in Bangladesh's most sought-after prime neighborhoods.</p>
            </div>
            <div class="mt-3 mt-md-0">
                <a asp-controller="Projects" asp-action="Index" asp-route-sisterConcern="Recent Living Ltd" class="btn btn-outline-success rounded-pill px-4">
                    View All Living Projects &rarr;
                </a>
            </div>
        </div>

        <div class="row g-4">
            @if (Model.Any())
            {
                @foreach (var p in Model)
                {
                    <div class="col-md-6 col-lg-4" data-aos="fade-up">
                        <div class="card h-100 glass-card glass-card-hover overflow-hidden d-flex flex-column project-card-modern">
                            <div class="project-card-image-wrap position-relative overflow-hidden">
                                <img src="@(p.PrimaryImage?.ImagePath ?? "/images/properties/lumina-1.svg")" alt="@p.Name" class="w-100 h-100 project-card-img" />
                                <div class="position-absolute top-0 start-0 m-3">
                                    <span class="badge badge-status-@(p.Status.ToString().ToLower()) shadow-sm">@p.Status</span>
                                </div>
                                <div class="position-absolute top-0 end-0 m-3">
                                    <span class="badge bg-success bg-opacity-90 text-white shadow-sm fw-semibold">@(p.PropertyType ?? "Residential")</span>
                                </div>
                            </div>

                            <div class="card-body p-4 d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-success small fw-bold text-uppercase tracking-wider">Recent Living Ltd.</span>
                                    @if (p.CompletionYear.HasValue)
                                    {
                                        <span class="text-muted small"><i class="bi bi-calendar3 me-1"></i>Est. @p.CompletionYear</span>
                                    }
                                </div>
                                <h5 class="card-title fw-bold font-serif mb-2 fs-5">
                                    <a asp-controller="Projects" asp-action="Details" asp-route-slug="@p.Slug" class="text-decoration-none text-body stretched-link">
                                        @p.Name
                                    </a>
                                </h5>
                                <p class="text-muted small mb-3"><i class="bi bi-geo-alt me-1 text-success"></i>@p.Address</p>

                                @if (p.FeatureList.Any())
                                {
                                    <div class="d-flex flex-wrap gap-1 mb-4">
                                        @foreach (var feat in p.FeatureList.Take(3))
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-body border small fw-normal">@feat</span>
                                        }
                                    </div>
                                }

                                <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                                    <span class="text-success fw-semibold small d-inline-flex align-items-center gap-1">
                                        View Details
                                    </span>
                                    <span class="btn btn-outline-success btn-sm rounded-circle p-2">
                                        <i class="bi bi-arrow-right"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-4">
                    <p class="text-muted">Explore our complete portfolio on the projects catalog.</p>
                </div>
            }
        </div>
    </div>
</section>

<!-- Joint Venture Landowner Partnership Portal -->
<section id="joint-venture" class="py-5 border-top bg-body-tertiary">
    <div class="container py-lg-4">
        <div class="glass-card p-4 p-lg-5 shadow-lg" data-aos="zoom-in">
            <div class="row g-5 align-items-center">
                <div class="col-lg-5">
                    <div class="d-inline-flex align-items-center gap-2 mb-3 px-3 py-1 rounded-pill bg-success bg-opacity-10 text-success border border-success border-opacity-25 small fw-bold">
                        <i class="bi bi-handshake-fill"></i> Landowner Joint Venture
                    </div>
                    <h2 class="display-6 fw-bold font-serif mb-3">Partner With Recent Living Ltd.</h2>
                    <p class="text-muted mb-4 lh-lg">
                        Are you a landowner in Dhaka or across Bangladesh? At Recent Living Ltd., we bring together landowners, investors, and elite architects to transform your land into a high-value landmark under a mutually rewarding and transparent Joint Venture partnership.
                    </p>
                    <div class="d-flex flex-column gap-3 text-muted small">
                        <div class="d-flex align-items-center gap-3">
                            <span class="p-2 rounded-circle bg-success bg-opacity-10 text-success"><i class="bi bi-shield-check"></i></span>
                            <span>Fair & transparent ratio sharing with legal guarantees.</span>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <span class="p-2 rounded-circle bg-success bg-opacity-10 text-success"><i class="bi bi-stopwatch"></i></span>
                            <span>Strict commitment to scheduled completion and handover.</span>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <span class="p-2 rounded-circle bg-success bg-opacity-10 text-success"><i class="bi bi-gem"></i></span>
                            <span>High-quality engineering and premium architectural finish.</span>
                        </div>
                    </div>
                </div>

                <div class="col-lg-7">
                    <form class="ajax-inquiry-form">
                        <input type="hidden" name="TargetedConcern" value="Recent Living Ltd" />
                        <input type="hidden" name="Subject" value="Landowner Joint Venture Proposal" />
                        <input type="hidden" name="PreferredProjectSlug" value="joint-venture-proposal" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Landowner Full Name *</label>
                                <input type="text" name="ClientName" class="form-control rounded-3 py-2" placeholder="e.g. Engr. Rafiqul Islam" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Contact Phone Number *</label>
                                <input type="tel" name="PhoneNumber" class="form-control rounded-3 py-2" placeholder="+880 1711 000000" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Email Address *</label>
                                <input type="email" name="EmailAddress" class="form-control rounded-3 py-2" placeholder="email@domain.com" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Land Location (Area / Sector) *</label>
                                <input type="text" class="form-control rounded-3 py-2" placeholder="e.g. Gulshan 2 / Bashundhara R/A / Uttara" required />
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Land Details (Size in Katha, Front Road Width, Facing, Status) *</label>
                                <textarea name="Message" class="form-control rounded-3" rows="4" placeholder="Please specify: Plot size (e.g. 10 Katha), Road width (e.g. 40 ft), North/South facing, Registration status, etc." required></textarea>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-success rounded-pill px-5 py-3 w-100 fw-bold shadow-sm">
                                    <i class="bi bi-send-fill me-2"></i>Submit Joint Venture Proposal
                                </button>
                                <div class="inquiry-alert-box d-none"></div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
